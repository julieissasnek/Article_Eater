  "title": "DESIGNING NON-STRESSED PSYCHOLOGICAL PUBLIC SPACES",
  "authors": "Eslam Elsamahy et al., 2018",
  "abstract_summary": "This paper investigates the impact of urban public spaces and user activities on psychological stress in Tripoli, Lebanon. Using observation and a questionnaire (N=65) in El-Tall Square, the study identifies key stressors (traffic jam, noise, overcrowding, visual pollution, lack of cleanness) and stress-reducing factors (green areas, water features, architectural heritage, organized movement flow). The findings highlight a strong relationship between urban context, sensory experience, and psychological stress, aiming to inform the design of non-stressed public spaces.",
  "research_question_or_aim": "To study urban stress factors from the point of human sensory experience in relation to urban public space and users' activities, aiming to evaluate a specific urban public space (El-Tall Square in Tripoli, Lebanon) and develop a designing methodology for non-stressed psychological public spaces.",
  "methodology": {
    "study_design": "Mixed-methods (analytical study using observation and questionnaire survey)",
    "participants": {
      "n_total": 65,
      "demographics": "Local residents and users of El-Tall public space in Tripoli and surrounding context. Gender: 41.5% Male, 58.5% Female. Age groups: 18-29 (53), 30-44 (9), To 18 (2), Above 60 (1), 45-59 (0)."
    },
    "setting": "El-Tall Square ('Sahet El-Tall'), a historic urban public space in Tripoli, Lebanon, including Al-Manchieh central Park, El-Tall Square, and Tripoli Municipality garden.",
    "measures": [
      "Observation analysis: vehicle/pedestrian movement, green areas, water features, activities, noise levels, and stress/feeling areas.",
      "Online questionnaire survey (Google Form): perceptions and experience, psychological stress level (attention and annoyance factors), main stressors affecting space users. (Sampling calculation: 90% confidence level, 10% standard error)."
    ],
    "analysis_methods": "IBM SPSS statistics v20 for questionnaire data analysis."
  },
