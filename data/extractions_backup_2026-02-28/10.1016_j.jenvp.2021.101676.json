  "title": "Psychological and neural responses to architectural interiors",
  "authors": "Alexander Coburn et al., 2020",
  "research_question": "1) Can aesthetic responses to architectural scenes be reduced to a few key psychological dimensions? 2) Are these dimensions sensitive to salient design features and Global Image Properties (GIPs)? 3) Do these psychological dimensions correlate with neural activation patterns, and to what extent are these correlations modulated by task?",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 1430,
    "description": "Experiment 1: 798 US-based adults (391 women, 401 men, 6 other), ages 18-75 (M=38.06, SD=11.96), education 5-22 years (M=15.04, SD=2.11). Experiment 2: 614 American adults (305 women, 307 men, 2 other), ages 19-72 (M=35.68, SD=10.87), education 2-26 years (M=15.26, SD=2.31). Experiment 3: 18 healthy participants (12 females, 6 males, average age = 23.39 years, SD = 4.49) from Canary Islands.",
    "recruitment": "Experiment 1 & 2: Amazon's Mechanical Turk. Experiment 3: Reanalysis of previously published fMRI studies."
  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "200 images of interior architectural spaces, counterbalanced on perceived enclosure (open, closed), ceiling height (high, low), and contour (round, square). This yielded 8 experimental conditions (n=25 per condition): closed square low, closed square high, closed round low, closed round high, open square low, open square high, open round low, and open round high.",
      "n_stimuli": 200,
      "source": "Section 2.1.1, Figure 2"
    }
  ],
  "measures": [
    {
      "construct": "Aesthetic responses to architectural interiors",
      "instrument": "16 aesthetic rating scales (Complexity, Organization, Naturalness, Beauty, Personalness, Interest, Modernity, Valence, Stimulation, Vitality, Comfort, Relaxation, Hominess, Uplift, Approachability, Explorability) on a 7-point sliding semantic differential scale. Reduced to 9 non-redundant variables for Experiment 2 PCA: Complexity, Organization, Naturalness, Beauty, Personalness, Interest, Valence, Hominess, Approachability.",
      "type": "self_report"
    },
    {
      "construct": "Brain activation",
      "instrument": "fMRI (Statistical Parametric Mapping SPM12)",
      "type": "neural"
    },
    {
      "construct": "Beauty judgments",
      "instrument": "Button press 'beautiful' or 'not beautiful'",
      "type": "behavioral"
    },
