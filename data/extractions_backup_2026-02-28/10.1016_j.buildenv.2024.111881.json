  "title": "Visual and acoustic discomfort: A comparative study of impacts on individuals with and without ADHD using electroencephalogram (EEG)",
  "authors": "Sara Bagheri et al., 2024",
  "research_question": "How do specific lighting and sound conditions impact individuals with and without Attention-Deficit/Hyperactivity Disorder (ADHD) in terms of comfort perception, task performance, eye pupil diameter, heart rate, skin temperature, and brain activity (EEG)?",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 27,
    "description": "10 males, 17 females, aged between 18 and 34 years (mean = 26.3, SD = 4.37). 14 participants were diagnosed with ADHD and continued their medication regimen; 13 reported no ADHD diagnosis. All had normal or corrected-to-normal vision.",
    "recruitment": "Recruited for this experiment (details not specified beyond this statement)."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Six controlled laboratory environmental conditions with modified lighting and sound designs. Lighting conditions included: (1) Warm light (3500 K, 350 lx), (2) Cool light (6500 K, 830 lx), (3) Flickering light (3500 K, 5-10 Hz, 50-830 lx random brightness). Sound conditions included: (1) Silence, (2) White noise (40 dB), (3) Classroom noise (75 dB). Conditions were permutations: Warm-Silent, Cool-Silent, Warm-White, Warm-Noisy, Cool-Noisy, Flicker-Silent.",
      "n_stimuli": 6,
      "source": "Section 2.1, Table 1, Table 2"
    }
  ],
  "measures": [
    {
      "construct": "Subjective comfort perception",
      "instrument": "Likert scale (1-5, 1=very uncomfortable, 5=very comfortable)",
      "type": "self_report"
    },
