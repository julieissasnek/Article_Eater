  "title": "Semantic differential analysis of the soundscape in urban open public spaces",
  "authors": "J. Kang, M. Zhang, 2010",
  "research_question": "To identify factors that characterise the soundscape in urban open public spaces, to understand how people evaluate perceived soundscape, and to examine differences between designers and the general public in soundscape evaluation.",
  "design_type": "cross_sectional",
  "participants": {
    "n": 762,
    "description": "Stage 1: 48 university students (18-25 years old, 30 males, 18 females, audiologically normal) in Sheffield, UK. Stage 2: 491 general public (users, not passers-by, over 40% below 24 years old, generally high education, many students/working people, more males than females) in Sheffield, UK. Stage 3: 223 architectural students in Sheffield, UK.",
    "recruitment": "Stage 1: University students. Stage 2: Randomly selected users in public squares. Stage 3: Architectural students."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Four typical urban open public spaces in Sheffield, UK: Union Square (near roundabout, heavy traffic, loud music, birds, pedestrian/bike, conversations), Devonshire Green (large green space, skate park, distant traffic, birds, pedestrian/bike, construction noise), Barkers Pool (city centre, pedestrian area, light traffic, conversations, footsteps, skateboarding, wind, street singers, music from surrounding buildings), and Peace Gardens (city centre, multi-story buildings, busy road, water fountains/cascades, distant traffic, chatting, children's shouting, demolition noise in autumn/winter).",
      "n_stimuli": 4,
      "source": "Fig. 1 and Methods section"
    }
  ],
