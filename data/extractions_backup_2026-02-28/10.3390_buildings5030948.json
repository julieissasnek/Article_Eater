    },
    {
      "variable": "Type and amount of Biophilic feature",
      "effect": "The specific type and amount of natural elements (e.g., plant density, color of flowers, amount of wood) can modulate outcomes like productivity, affect, and preference.",
      "significant": true,
      "subgroup_effects": "High plant density can decrease productivity but increase positive affect. Red flowers can be fatiguing. Intermediate wood amounts are preferred."
    }
