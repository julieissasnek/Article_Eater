  "mechanisms": [
    "Indoor lighting acts as an affective source, conveying different emotional meanings to different age groups and genders.",
    "Age-related visual impairments influence the perception of room light (brightness, coolness).",
    "Mood congruence effect: current mood influences the recall of mood-congruent information."
  ],
  "moderators": [
    "Gender",
    "Age",
    "Type of lamp (color temperature)"
  ],
  "implementation_implications": [
    "The color parameters of office lighting are important for an occupant's individual, psychological lighting-demands, especially considering age and gender differences in mood reactions to lighting."
  ],
