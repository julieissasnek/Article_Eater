  "title": "Anticipatory vibrotactile cueing facilitates grip force adjustment",
  "authors": "Shogo Okamoto et al., 2013",
  "research_question": "How do anticipatory vibrotactile cues influence the latency and magnitude of grip force adjustment in response to an unexpected load disturbance?",
  "design_type": "within_subjects",
  "participants": {
    "n": 5,
    "description": "Five volunteer participants (excluding authors) from the research staff of the institution, wore headphones playing pink noise.",
    "recruitment": "Volunteer participants from research staff"
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "An instrumented and actuated parallelepiped-shaped handle held between the thumb and index finger. The handle could be jerked (pulling force) and/or provide vibrotactile stimulation (250 Hz or 100 Hz) to the gripping fingers. Four main conditions: 1) Load only, 2) Vibrotactile only (250 Hz), 3) Load + Vibrotactile (250 Hz, 50 ms before load), 4) Load + Vibrotactile (100 Hz, 50 ms before load). A follow-up Condition 5 (Vibrotactile only) was used for conscious response.",
      "n_stimuli": 4,
      "source": "Figure 1 and Section 2.3"
    }
  ],
  "measures": [
    {
      "construct": "Latency of grip force adjustment",
      "instrument": "Time difference between onset of traction force/vibrotactile cue end and onset of grip force change (threshold 20 N/s)",
      "type": "behavioral"
    },
    {
      "construct": "Increase in grip force",
      "instrument": "Difference between maximum grip force and average of 100 ms before onset of traction/vibrotactile stimulation",
      "type": "behavioral"
    },
    {
      "construct": "Net displacement of grip handle",
      "instrument": "Difference between highest position after force stimulus and average of 100 ms before onset of traction, measured by encoder",
      "type": "behavioral"
    },
    {
      "construct": "Finger pad deformation",
      "instrument": "Differential acceleration between nail and contact surface, integrated twice",
      "type": "physiological"
    },
    {
      "construct": "Tangential force",
      "instrument": "High resolution, high bandwidth force sensor (Kistler 9217A)",
      "type": "physiological"
    },
    {
      "construct": "Normal grip force",
      "instrument": "Two force sensors (Kistler 9313AA1)",
      "type": "physiological"
    }
  ],
