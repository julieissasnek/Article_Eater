  "title": "The impact of light and colour on psychological mood: a cross-cultural study of indoor work environments",
  "authors": "Rikard K\u00fcller et al., 2006",
  "research_question": "To determine whether indoor lighting and colour would have any systematic impact on the mood of people working indoors.",
  "design_type": "longitudinal",
  "participants": {
    "n": 988,
    "description": "468 females and 520 males, aged 18 to 65 years (mean 39.4 SD 9.85 years), working in indoor environments (offices, schools, industrial premises) in four countries: Argentina (27\u00b0 S), Saudi Arabia (26\u00b0 N), Sweden (56\u00b0 N), and the UK (52\u00b0 N).",
    "recruitment": "Employees working at least three-quarters of full time during daytime, excluding night-shift workers and those with previous records of prolonged illness."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Real work environments (offices, schools, industrial premises) in four countries (Argentina, Saudi Arabia, Sweden, UK) with varying latitudes and seasonal day lengths. Environmental features studied included objective illuminance, subjective lightness, subjective interior colour, and physical distance to the nearest window.",
      "n_stimuli": null,
      "source": "p.4, section 3.1"
    }
  ],
  "measures": [
    {
      "construct": "Psychological mood",
      "instrument": "Emotional status index (composite of 12 four-grade rating scales: rested/tired, alert/drowsy, awake/sleepy, interested/bored, efficient/inefficient, devoted/indifferent, secure/anxious, friendly/angry, happy/sad, confident/hesitating, independent/dependent, strong/weak). Coefficient alpha = 0.82.",
      "type": "self_report"
    },
    {
      "construct": "Subjective lighting conditions",
      "instrument": "Four-graded scale (1=clearly insufficient, much too dark; 2=slightly insufficient, a little bit too dark; 3=just right; 4=very bright and glaring, too much light). Between seasons consistency coefficient alpha = 0.82.",
      "type": "self_report"
    },
    {
      "construct": "Subjective interior decoration/colour",
      "instrument": "Four-graded scale (1=no colour at all, very subdued and monotonous; 2=colours are rather neutral; 3=some colour but not very vivid; 4=very colourful and vivid). Between seasons consistency coefficient alpha = 0.86.",
      "type": "self_report"
    },
    {
      "construct": "Distance from workplace to nearest window",
      "instrument": "Estimated physical distance (self-report).",
      "type": "self_report"
    },
    {
      "construct": "Objective indoor illuminance",
      "instrument": "Horizontal illuminance values (lux) measured with calibrated luxmeters on the desktop.",
      "type": "observational"
    },
    {
      "construct": "Length of day",
      "instrument": "Computed from sunrise to sunset for each region at five times of the year.",
      "type": "observational"
    }
  ],
