            "bridging_quality": "strong",
            "maturity": "established",
            "notes": "Warren (1984) affordance thresholds. Deviation from optimal 0.25 x leg_length increases energy cost and control demand.",
            "parameter_range": {
                "MFI_baseline": "0.95-1.00 (Level corridor)",
                "MFI_stairs_optimal": "0.80-0.90",
                "MFI_stairs_steep": "0.65-0.80",
