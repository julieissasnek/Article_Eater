      "to_level": "personal_epistemic",
      "bridging_quality": "moderate",
      "maturity": "supported",
      "evidence_base": "Gehl (1971) caf\u00e9 chair principle"
    }
  ],
  "scope_conditions": [
    "Requires visual access to other people (not merely knowing they are present)",
    "Mirror activation is automatic \u2014 cannot be voluntarily suppressed when others are visible",
    "Modulated by social identity: in-group members produce stronger resonance than out-group",
    "Affective contagion can be negative: hospital waiting areas, distressed crowds produce vicarious distress"
  ],
  "moderators": [
    "number_of_visible_others (more people \u2192 stronger ambient resonance, up to saturation ~25-30)",
    "emotional_valence_of_crowd (positive crowd \u2192 positive contagion; negative \u2192 negative)",
    "glass_and_transparency (glass walls provide visual access without acoustic coupling \u2014 'aquarium effect')",
    "individual_empathic_tendency (high-empathy individuals show stronger resonance)"
  ],
  "interactions": [
