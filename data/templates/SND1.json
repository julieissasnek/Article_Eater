            "unit": "unitless",
            "range": {
                "min": 0,
                "max": 2
            },
            "description": "Slope of the power spectral density log-log plot (1/f^alpha). Pink noise = 1.0."
        },
        {
            "name": "background_dba",
            "type": "float",
            "unit": "dBA",
            "range": {
                "min": 30,
                "max": 80
