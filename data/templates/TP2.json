            "to_variable": "episodic_boundary_strength",
            "activity": "determines",
            "from_level": "environmental",
            "to_level": "cognitive",
            "bridging_quality": "strong",
            "maturity": "established",
            "notes": "Zacks et al. (2007) EST. More channels changing = stronger segmentation.",
            "parameter_range": {
                "d_1_channel_spatial": "0.25 (Minimal)",
                "d_2_channels": "0.45 (Clear)",
                "d_3_channels": "0.68 (Strong)",
                "d_4_channels_all": "0.88 (Very Strong)",
                "super_additivity": "+15-20% for synchronized change",
                "channel_weights": "Spatial(0.25) > Light(0.20) > Sound(0.18) > Material(0.15)"
            }
        },
        {
            "from_variable": "episodic_boundary_crossing",
            "to_variable": "working_memory_reset",
