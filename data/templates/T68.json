{
  "template_id": "SALIENCE_NETWORK_SWITCH_001",
  "name": "Salience Network Switching Mechanism",
  "structural_pattern": "SWITCH",
  "higher_order_principle": "The Salience Network (SN), anchored in the Anterior Insula (AI) and dACC, acts as a dynamic switch. It monitors internal and external inputs for salience. If salience exceeds a threshold, the AI disengages the Default Mode Network (DMN) and engages the Central Executive Network (CEN/TPN). Restoration (T27) requires the SN to remain quiescent or in 'monitoring' mode without triggering a full network switch. 'Soft Fascination' is a stimulus that engages the SN gently without forcing a switch to CEN.",
  "transferable_to": [
    "interruption management (open office design)",
    "notification design (digital hygiene)",
    "restorative environments (minimizing salience spikes)",
    "attention economy modeling"
  ],
  "framework_ids": [
    "NM",
    "CC"
  ],
  "causal_links": [
    {
      "from_variable": "input_salience_aggregate",
      "to_variable": "anterior_insula_evaluation",
      "activity": "salience_integration",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Sridharan et al., 2008; Menon & Uddin, 2010",
      "parameters": {
        "inputs": "External (loud noise, T58), Internal (pain, T12, T57), Cognitive (conflict, T45)",
        "role": "AI integrates all these into a 'salience map'"
      }
    },
    {
      "from_variable": "AI_salience_signal_high",
      "to_variable": "network_state_switching",
      "activity": "DMN_suppression_CEN_activation",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Sridharan et al., 2008",
      "parameters": {
        "mechanism": "Right AI sends causal outflow to DMN (suppressing it) and CEN (activating it)",
        "cost": "Network switching is metabolically costly and disrupts ongoing cognitive processes (switch cost)"
      }
    },
    {
      "from_variable": "AI_salience_signal_low_moderate",
      "to_variable": "DMN_maintenance_or_coactivation",
      "activity": "restorative_monitoring",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "MEDIUM",
      "maturity": "how-plausibly",
      "key_evidence": "Hunter et al., 2011 (Soft Fascination)",
      "parameters": {
        "state": "Soft fascination likely involves weak SN activation that guides DMN usage rather than switching it off. This allows 'wandering' attention."
      }
    }
  ],
  "scope_conditions": [
    "Threshold is variable: Anxious individuals (high trait anxiety) have a lower SN switch threshold (distracted easily).",
    "Salience is context-dependent: Your name is salient; a random name is not.",
    "Crucial functionality: The switch is necessary for survival (reacting to threat). Restoration design is about managing the switch, not disabling it."
  ],
  "moderators": [
    "trait_anxiety (lowers switch threshold)",
    "cognitive_load (current task engagement affects switch susceptibility)",
    "fatigue (tired integrative hub fails to regulate switching effectively)"
  ],
  "interactions": [
    {
      "template": "T27 (NM_DMN_MAINTENANCE_001)",
      "type": "CONTROLLER",
      "description": "T68 controls T27. A T68 switch event terminates T27 state."
    },
    {
      "template": "T58 (MS_ACOUSTIC_ECOLOGY_001)",
      "type": "INPUT",
      "description": "Abrupt sounds or intelligible speech are high-salience inputs to T68."
    },
    {
      "template": "T57 (IC_THERMAL_COMFORT_001)",
      "type": "INPUT",
      "description": "Thermal discomfort is a persistent internal salience input to T68."
    }
  ],
  "overall_maturity": "how-actually",
  "key_references": [
