{
  "template_id": "NATURE_VIEW_CONVERGENCE_001",
  "display_id": "VIEW1",
  "name": "Nature View Convergence — Multi-Channel Prediction Confirmation in Visual Access to Outdoors",
  "structural_pattern": "A window view of nature is a 'super-stimulus' that engages 5 distinct PE channels simultaneously: 1) Fractal Fluency (T1), 2) Prospect/Refuge (SC2/T5), 3) Soft Fascination (ART/T25), 4) Temporal Variation (L5), and 5) Biophilic Safety Signal. The convergence of these independent confirmation signals produces a robust stress-reduction and attention-restoration effect that exceeds single-channel stimuli.",
  "higher_order_principle": "Multi-Channel Convergence. Natural stimuli (like daylight/wood/views) are powerful because they are 'wide-band' confirmation signals for the human predictive system, matching priors across multiple sensory and cognitive scales.",
  "transferable_to": [
    "Healthcare Design (patient recovery)",
    "Workplace Design (productivity/stress)",
    "Educational Design (attention management)"
  ],
  "framework_ids": [
    "stress_reduction_theory",
    "attention_restoration_theory",
    "biophilia",
    "predictive_processing",
    "fractal_fluency"
  ],
