{
  "template_id": "ER_ECOLOGICAL_RATIONALITY_001",
  "display_id": "T37",
  "name": "Ecological Rationality in Navigation",
  "structural_pattern": "FIT",
  "higher_order_principle": "Decision-making effectiveness depends on the fit between environmental information structure and cognitive heuristics. 'Less is more': in high-complexity environments, simple heuristics (e.g., 'follow the crowd') often outperform complex deliberation. Environments should be designed to support 'satisficing'.",
  "transferable_to": [
    "wayfinding system design",
    "choice architecture in buildings",
    "egress design",
    "retail layout"
  ],
  "framework_ids": [
    "HC",
    "EF",
    "PP"
  ],
  "causal_links": [
    {
      "from_variable": "environmental_cue_structure",
      "to_variable": "heuristic_success",
      "activity": "match_strategy",
      "from_level": "environmental",
      "to_level": "behavioral",
      "bridging_quality": "MEDIUM",
      "maturity": "established",
      "key_evidence": "Gigerenzer & Gaissmaier, 2011",
      "parameters": {
        "cue_validity": "predictive power of signs/landmarks",
        "redundancy": "correlation between cues"
      }
    },
    {
      "from_variable": "heuristic_success",
      "to_variable": "navigational_outcome",
      "activity": "enable_wayfinding",
      "from_level": "behavioral",
      "to_level": "behavioral",
      "bridging_quality": "HIGH",
      "maturity": "established",
      "key_evidence": "Applied ecological rationality literature",
      "parameters": {
        "decision_speed": "faster with fast-and-frugal heuristics",
        "satisfaction": "higher when satisficing is enabled"
      }
    }
  ],
  "scope_conditions": [
    "Applies to decision-under-uncertainty",
    "Heuristics fail if environment lies (low cue validity)",
    "Stress biases users toward simpler heuristics"
  ],
  "moderators": [
    "time_pressure (increases reliance on simple heuristics)",
    "information_overload (makes complex strategies impossible)"
  ],
  "interactions": [
    {
      "template": "T43 (MB_MF_ARBITRATION)",
      "type": "MECHANISM",
      "description": "Ecological rationality describes the 'why' (fit); T43 describes the neural 'how' (arbitration between systems)."
    }
  ],
  "overall_maturity": "how-plausibly",
  "key_references": [
    "Gigerenzer & Gaissmaier (2011) Annual Review of Psychology",
    "Simon (1956) Psychological Review"
  ],
  "short_description": "Decision-making effectiveness depends on the fit between environmental information structure and cognitive heuristics",
