{
    "template_id": "NATURAL_MATERIAL_CONVERGENCE_001",
    "name": "The Natural Material Convergence (Wood Effect)",
    "structural_pattern": "CONVERGENCE",
    "higher_order_principle": "Natural materials like wood or stone are processed as 'Super-Stimuli' because they offer coherent convergence across 5 channels: (1) Visual Fractal (Grain), (2) Haptic Thermal (Low Effusivity/Warm), (3) Haptic Texture (Roughness), (4) Acoustic (Damping), and (5) Olfactory (Organic Volatiles). This convergence signals 'Life' or 'Nature' (Biophilia) more strongly than image-only biophilia.",
    "transferable_to": [
        "biophilic design specification",
        "healthcare patient room walls (wood effect on stress)",
        "classroom design"
    ],
    "framework_ids": [
        "MS",
        "EC"
    ],
    "causal_links": [
        {
            "from_variable": "natural_material_presence",
            "to_variable": "autonomic_stress_reduction",
            "activity": "biophilic_material_response",
            "from_level": "personal_epistemic",
            "to_level": "subpersonal",
            "bridging_quality": "MEDIUM",
            "maturity": "how-actually",
            "key_evidence": "Fell, 2010; Ikei et al., 2017",
            "parameters": {
                "effect": "Reduced cortisol, reduced sympathetic activation (compared to white/plastic)",
                "magnitude": "Significant effect observed with ~45% wood coverage (Fell)"
            }
        }
    ],
    "scope_conditions": [
        "Authenticity matters (T75). Fake wood often shows smaller or null effects.",
        "Quantity matters: Too much wood (sauna effect) can be oppressive. 30-60% seems optimal."
    ],
    "moderators": [
        "finish_type (heavy varnish blocks olfactory/tactile channels)",
        "species (grain pattern)",
        "prior_association (cultural meaning)"
    ],
