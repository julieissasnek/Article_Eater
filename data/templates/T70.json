{
    "template_id": "CIRCADIAN_ARCH_REGULATION_001",
    "name": "Circadian Architecture and Temporal Light Regulation",
    "structural_pattern": "ALIGNMENT",
    "higher_order_principle": "Circadian regulation is an alignment problem. The biological clock (SCN) expects a specific temporal architecture of light: High Melanopic EDI in the morning/day, Low Melanopic EDI in the evening/night. Mismatch (Temporal PE) creates 'social jetlag' or circadian disruption. Architecture that mimics the solar arch (dynamic light) minimizes this error.",
    "transferable_to": [
        "tunable white lighting systems",
        "hospital patient room lighting",
        "residential bedroom design",
        "Arctic/Antarctic station design"
    ],
    "framework_ids": [
        "NM",
        "PP"
    ],
    "causal_links": [
        {
            "from_variable": "temporal_light_profile",
            "to_variable": "circadian_phase_alignment",
            "activity": "entrainment_matching",
            "from_level": "subpersonal",
            "to_level": "subpersonal",
            "bridging_quality": "HIGH",
            "maturity": "how-actually",
            "key_evidence": "Foster, 2021; Roenneberg et al., 2003",
            "parameters": {
                "match": "Morning bright/blue + Evening dim/amber = Robust Entrainment",
                "mismatch": "Morning dim + Evening bright/blue = Phase Delay (Insomnia, Social Jetlag)",
                "amplitude": "High amplitude (contrast between day and night) strengthens the rhythm"
            }
        },
        {
            "from_variable": "phase_delay_mismatch",
            "to_variable": "health_consequences",
            "activity": "circadian_disruption_cascade",
            "from_level": "subpersonal",
            "to_level": "subpersonal",
            "bridging_quality": "HIGH",
            "maturity": "how-actually",
            "key_evidence": "Roenneberg & Merrow, 2016",
            "parameters": {
                "effects": "Sleep fragmentation, metabolic syndrome risk, mood instability, cognitive deficit",
                "connection": "Links T70 directly to T29 (Allostatic Load)"
            }
        }
    ],
    "scope_conditions": [
        "Requires sufficient duration: Brief exposure (checking phone) has less effect than sustained exposure (watching TV/room lights), but sensitivity increases at night.",
        "Individual sensitivity: 'Dark adaptation' makes the eye more sensitive to light at night, so even low levels can disrupt melatonin."
    ],
    "moderators": [
        "chronotype (owls more susceptible to delay)",
        "light_history (bright days protect against night light)",
        "spectrum (blue content matters more than total lux)"
    ],
    "interactions": [
        {
            "template": "T55 (NM_CIRCADIAN_ENTRAINMENT_001)",
            "type": "EXTENSION",
            "description": "T55 defines the ipRGC mechanism. T70 defines the TEMPORAL PATTERN or 'Architectural' application of that mechanism."
        },
        {
            "template": "T72 (CCT_TEMPORAL_ECOLOGICAL_001)",
            "type": "PARTNER",
            "description": "T70 (Intensity) and T72 (Color) typically covary in natural light and should covary in design."
        }
    ],
    "overall_maturity": "how-actually",
    "key_references": [
