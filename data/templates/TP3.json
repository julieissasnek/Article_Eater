      "parameter_range": {
        "trajectory_wood": "Positive: Silvering, grain exposure increases High-freq detail. Converges to D~1.3.",
        "trajectory_stone": "Positive: Erosion softens edges, lichen adds complexity. Converges to D~1.3.",
        "trajectory_copper": "Positive: Verdigris adds chromatic complexity and texture.",
        "trajectory_glass": "Negative: Dirt accumulation is opaque noise, not fractal info. Requires cleaning to maintain state.",
