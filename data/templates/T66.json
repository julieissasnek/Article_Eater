{
    "template_id": "NM_SAFETY_SIGNALING_001",
    "name": "Learned Safety and Active Threat Inhibition",
    "structural_pattern": "INHIBITION",
    "higher_order_principle": "Safety is not just the absence of threat; it is an active neurological state maintained by the vmPFC inhibiting the amygdala. Environments that provide 'Learned Safety' cues (familiarity, refuge, clear boundaries) actively suppress default threat responses. This mechanism explains why 'Refuge' (T3 + T66) is restorative: it offloads the metabolic cost of vigilance by actively silencing the threat detection system.",
    "transferable_to": [
        "home design (sanctuary effect)",
        "healthcare waiting areas (reducing anxiety)",
        "urban parks (prospect-refuge)",
        "secure attachment facilitation"
    ],
    "framework_ids": [
        "NM"
    ],
    "causal_links": [
        {
            "from_variable": "safety_cue_presence",
            "to_variable": "vmPFC_safety_signal_generation",
            "activity": "contextual_safety_learning",
            "from_level": "subpersonal",
            "to_level": "subpersonal",
            "bridging_quality": "HIGH",
            "maturity": "how-actually",
            "key_evidence": "Kalisch et al., 2006; Pollak et al., 2008",
            "parameters": {
                "cues": "predictability, control, protected boundaries, trusted social presence",
                "mechanism": "vmPFC encodes 'safety value' of the context"
            }
        },
        {
            "from_variable": "vmPFC_safety_signal",
            "to_variable": "intercalated_cell_activation",
            "activity": "amygdala_inhibition",
            "from_level": "subpersonal",
            "to_level": "subpersonal",
            "bridging_quality": "HIGH",
            "maturity": "how-actually",
            "key_evidence": "Likhtik et al., 2008",
            "parameters": {
                "pathway": "vmPFC -> ITC (Intercalated Cells of Amygdala) -> Central Nucleus inhibition",
                "effect": "GABAergic inhibition of the fear output",
                "consequence": "Vigilance reduction, metabolic conservation"
            }
        },
        {
            "from_variable": "amygdala_inhibition",
            "to_variable": "exploratory_behavior_permission",
            "activity": "release_of_inhibition_on_behavior",
            "from_level": "subpersonal",
            "to_level": "personal_epistemic",
            "bridging_quality": "MEDIUM",
            "maturity": "how-plausibly",
            "key_evidence": "Gray & McNaughton, 2000",
            "parameters": {
                "dynamic": "When threat is inhibited, the Behavioral Inhibition System (BIS) relaxes, allowing the Behavioral Activation System (BAS) or exploration (T11) to proceed."
            }
        }
    ],
    "scope_conditions": [
        "Safety learning is context-specific (hippocampal dependent). A cue safe in one room may not be safe in another.",
        "Trauma impairs this mechanism: PTSD is characterized by failure of the vmPFC to inhibit the amygdala (deficient safety signaling).",
        "Extinction of fear is a new learning of safety, not unlearning of fear. Architecture facilitates this extinction learning."
    ],
    "moderators": [
        "prior_trauma (impairs T66)",
        "environmental_predictability (predictable stressors are safer than unpredictable ones)",
        "control (perceived control enhances safety signal)"
    ],
    "interactions": [
        {
            "template": "T5 (NM_THREAT_MODULATION_001)",
            "type": "INHIBITOR",
            "description": "T66 actively inhibits T5. This is the definition of the mechanism."
        },
        {
            "template": "T65 (NM_VAGAL_REGULATION_001)",
            "type": "DOWNSTREAM",
            "description": "Amygdala inhibition (T66) removes the brake on the vagus, allowing T65 (Vagal Regulation) to occur."
        },
        {
            "template": "T3 (HC_COGNITIVE_MAP_001)",
            "type": "CONTEXT",
            "description": "The hippocampus (T3) provides the context in which the safety signal is valid."
        }
    ],
    "overall_maturity": "how-actually",
    "key_references": [
        "Kalisch, R., et al. (2006). Context-dependent human extinction memory is mediated by a ventromedial prefrontal-hippocampal network. Journal of Neuroscience",
        "Likhtik, E., et al. (2008). Amygdala intercalated neurons are required for expression of fear extinction. Nature",
        "Pollak, D. D., et al. (2008). An animal model of a behavioral intervention for depression. Neuron"
    ],
    "display_id": "T66",
