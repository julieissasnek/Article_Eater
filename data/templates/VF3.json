{
    "template_id": "VISUAL_FORM_CEILING_HEIGHT_001",
    "display_id": "VF3",
    "name": "Ceiling Height and Cognitive Mode — The Priming of Abstract vs. Concrete Processing",
    "structural_pattern": "Architecture primes cognitive processing style through vertical scale. High ceilings (>3.0m) prime abstract, relational, and creative processing (exploratory mode). Low ceilings (<2.6m) prime concrete, item-specific, and detail-oriented processing (confinement mode). The mechanism is mediated by the Parahippocampal Place Area (PPA) and conceptual priming of 'freedom' vs. 'confinement' (Meyers-Levy & Zhu, 2007; Vartanian et al., 2015).",
    "higher_order_principle": "Vertical scale acts as a somatosensory-cognitive prime. The physical envelope of the space sets the default scope of attention and conceptual processing. Large vertical volume = broad scope (abstract). Compressed vertical volume = narrow scope (concrete).",
    "transferable_to": [
        "Workplace Design (matching ceiling height to task type)",
        "Retail Design (high for exploration, low for detailed evaluation)",
        "Educational Spaces (varied heights for different learning modes)"
    ],
    "framework_ids": [
        "embodied_cognition",
        "conceptual_metaphor_theory",
        "predictive_processing",
        "architectural_neuroscience"
    ],
    "causal_links": [
        {
            "from_variable": "ceiling_height",
            "to_variable": "perceived_confinement",
            "activity": "modulates",
            "from_level": "environmental",
            "to_level": "perceptual",
            "bridging_quality": "strong",
            "maturity": "established",
            "notes": "Vartanian et al. (2015) fMRI data shows differential PPA activation. High ceilings reduce confinement signal; low ceilings increase it."
        },
        {
            "from_variable": "perceived_chomfinement",
            "to_variable": "processing_style",
            "activity": "primes",
            "from_level": "perceptual",
            "to_level": "cognitive",
            "bridging_quality": "moderate",
            "maturity": "supported",
            "notes": "Meyers-Levy & Zhu (2007) behavioral data: High ceilings -> better performance on anagrams (abstract). Low ceilings -> better performance on item-specific tasks (concrete)."
        }
    ],
    "scope_conditions": [
        "Effect is strongest when the ceiling height is salient (noticed)",
        "Effect interacts with room area (proportionality references)",
        "Modulated by lighting (bright ceilings felt higher)"
    ],
    "moderators": [
