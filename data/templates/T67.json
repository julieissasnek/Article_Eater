{
  "template_id": "PP_PROCESSING_FLUENCY_001",
  "name": "Processing Fluency and Aesthetic Pleasure",
  "structural_pattern": "REINFORCEMENT",
  "higher_order_principle": "The brain is a metabolic miser. Stimuli that are processed efficiently (high fluency) are hedonically marked as positive. This 'warm glow' of familiarity or simplicity serves as a reinforcement signal for successful processing. This mechanism explains the aesthetic preference for fractals (T1), prototypes, symmetry, and high-contrast figure-ground relationships. Beauty is, in part, the feeling of processing ease.",
  "transferable_to": [
    "wayfinding design (legibility = pleasure)",
    "branding/logo design (simplicity bias)",
    "product design (prototypicality)",
    "UI/UX (familiarity and ease)"
  ],
  "framework_ids": [
    "PP",
    "EC"
  ],
  "causal_links": [
    {
      "from_variable": "stimulus_structural_properties",
      "to_variable": "processing_speed_and_accuracy",
      "activity": "visual_cortex_processing_efficiency",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Reber et al., 2004; Winkielman et al., 2003",
      "parameters": {
        "properties": "symmetry, fractal_scaling (1/f), contrast, clarity, prototypicality",
        "effect": "faster recognition, lower metabolic cost per bit"
      }
    },
    {
      "from_variable": "processing_fluency",
      "to_variable": "positive_affective_marking",
      "activity": "hedonic_attribution",
      "from_level": "subpersonal",
      "to_level": "personal_epistemic",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Winkielman & Cacioppo, 2001 (EMG Zygomaticus)",
      "parameters": {
        "mechanism": "Fluency triggers subtle activation of zygomaticus major (smile muscle) and subjective liking.",
        "attribution_error": "People misattribute the fluency of PROCESSING to the QUALITY of the object ('It's easy to see, so it must be true/good')."
      }
    },
    {
      "from_variable": "fluency_experience",
      "to_variable": "preference_judgment",
      "activity": "aesthetic_decision",
      "from_level": "personal_epistemic",
      "to_level": "personal_epistemic",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Reber, Schwarz, & Winkielman, 2004",
      "parameters": {
        "outcome": "Preference for high-fluency environments (e.g., Savannah hypothesis, clear paths)",
        "limit": "Too much fluency = boredom (T2 Goldilocks). Fluency needs a challenge to be interesting."
      }
    }
  ],
  "scope_conditions": [
    "Inverted-U: Maximum fluency is boring. Aesthetic pleasure peaks at 'Fluency + Discrepancy' or 'Fluency + Complexity' (Maya principle: Most Advanced Yet Acceptable).",
    "Individual variation: Experts find complex stimuli more fluent than novices (T45/E4 schema effect).",
    "Context: Fluency is valued in safety/restoration contexts; disfluency (challenge) may be valued in art/gaming contexts."
  ],
  "moderators": [
    "prior_exposure (mere exposure effect increases fluency)",
    "contrast (higher contrast increases perceptual fluency)",
    "duration (longer viewing allows fluency to develop for complex stimuli)"
  ],
  "interactions": [
    {
      "template": "T1 (PP_SPECTRAL_MATCH_001)",
      "type": "MECHANISM",
      "description": "Fractal fluency (T1) is a specific instance of T67. 1/f patterns are fluent because they match the visual system's tuning."
    },
    {
      "template": "T2 (PP_COMPLEXITY_GOLDILOCKS_002)",
      "type": "CONSTRAINT",
      "description": "T2 defines the upper limit of T67. The optimal point is a balance between Fluency (Simplicity) and Stimulation (Complexity)."
    },
    {
      "template": "RC_ART_SOFT_FASCINATION",
      "type": "CONTRIBUTOR",
      "description": "Soft fascination environments are typically high-fluency environments (easy to process), conserving attentional resources."
    }
  ],
  "overall_maturity": "how-actually",
  "key_references": [
