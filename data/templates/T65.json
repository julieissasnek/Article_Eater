{
  "template_id": "NM_VAGAL_REGULATION_001",
  "name": "Vagal Regulation and Social Engagement System",
  "structural_pattern": "MODULATION",
  "higher_order_principle": "The myelinated vagus (ventral vagal complex) acts as an active 'vagal brake' on heart rate, enabling rapid calming and social engagement. This is distinct from the mere absence of sympathetic threat (T5). Vagal tone (measured by HRV/RSA) is the physiological substrate of psychological safety and resilience. Architectural cues of safety (refuge, soft boundaries, biophilic forms) recruit the ventral vagus via the Nucleus Ambiguus.",
  "transferable_to": [
    "stress recovery rooms (enhancing HRV)",
    "collaborative workspaces (social engagement system)",
    "therapy environments",
    "school calm-down corners"
  ],
  "framework_ids": [
    "NM"
  ],
  "causal_links": [
    {
      "from_variable": "environmental_safety_cues",
      "to_variable": "vmPFC_top_down_control",
      "activity": "safety_assessment",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Porges, 2007; Thayer & Lane, 2009",
      "parameters": {
        "cues": "protected_back (refuge), clear_sightlines (prospect), acoustic_privacy, soft_geometry",
        "mediator": "vmPFC evaluates context as 'safe' and disinhibits the vagal brake"
      }
    },
    {
      "from_variable": "vmPFC_activation",
      "to_variable": "nucleus_ambiguus_stimulation",
      "activity": "vagal_brake_engagement",
      "from_level": "subpersonal",
      "to_level": "subpersonal",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Porges, 2007",
      "parameters": {
        "mechanism": "Nucleus Ambiguus sends inhibitory signals via myelinated vagus to SA node",
        "effect": "Rapid deceleration of heart rate, increased HRV (RSA)",
        "latency": "Very fast (<1s) compared to sympathetic deactivation (minutes)"
      }
    },
    {
      "from_variable": "ventral_vagal_activation",
      "to_variable": "social_engagement_behaviors",
      "activity": "prosocial_physiological_state",
      "from_level": "subpersonal",
      "to_level": "personal_epistemic",
      "bridging_quality": "HIGH",
      "maturity": "how-actually",
      "key_evidence": "Porges, 2011",
      "parameters": {
        "features": "enhanced facial affect recognition, prosody detection, middle ear muscle tuning (human speech freq)",
        "architectural_implication": "You cannot design for collaboration without designing for vagal safety. Stressed people (low vagal tone) literally cannot hear human voice frequencies as well."
      }
    }
  ],
  "scope_conditions": [
    "Requires 'Neuroception of Safety': subconscious detection of safety is a prerequisite. If T5 (Threat) is active, T65 is inhibited.",
    "Individual differences: baseline vagal tone (HRV) varies widely. Low baseline individuals need stronger environmental safety cues.",
    "Evolutionary hierarchy: Vagal withdrawal (freeze) -> Sympathetic (fight/flight) -> Ventral Vagal (social/safe). Environment regulates this hierarchy."
  ],
  "moderators": [
    "baseline_HRV (resilience)",
    "social_context (presence of trusted others enhances T65)",
    "acoustic_environment (low frequency noise inhibits T65/masks speech)"
  ],
  "interactions": [
    {
      "template": "T5 (NM_THREAT_MODULATION_001)",
      "type": "OPPOSITE",
      "description": "Reciprocal inhibition. High sympathetic (T5) withdraws the vagal brake (T65). T65 activation inhibits T5."
    },
    {
      "template": "T66 (NM_SAFETY_SIGNALING_001)",
      "type": "DRIVER",
      "description": "T66 (Safety Signaling) is the upstream cognitive/affective process that triggers T65 (Vagal Regulation)."
    },
    {
      "template": "T48 (CROSS_SOCIAL_AFFORDANCE_READING_001)",
      "type": "ENABLER",
      "description": "Vagal state enables accurate reading of social affordances. In high stress, social reading becomes threat-biased."
    }
  ],
  "overall_maturity": "how-actually",
  "key_references": [
    "Porges, S. W. (2007). The polyvagal perspective. Biological Psychology",
    "Thayer, J. F., & Lane, R. D. (2009). Claude Bernard and the heart-brain connection. Biological Psychology",
