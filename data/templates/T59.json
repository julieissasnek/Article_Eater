    "display_id": "T59",
    "name": "Creative Network Dynamics — The DMN-ECN-SN Coupling",
    "structural_pattern": "Creative cognition is not a single state but a dynamic switching between Default Mode Network (DMN, generation) and Executive Control Network (ECN, evaluation), mediated by the Salience Network (SN). Architecture supports this by providing 'Zones' that facilitate these specific network states or the switching between them.",
    "higher_order_principle": "Architectural support for cognitive phase-shifting. Different environments support different network topologies. Generative=DMN dominant. Evaluative=ECN dominant.",
    "transferable_to": [
        "Innovation Hubs",
        "Artist Studios",
        "Research Labs"
    ],
    "framework_ids": [
        "network_neuroscience",
        "creative_cognition_theory",
        "predictive_processing"
    ],
    "causal_links": [
        {
            "from_variable": "environmental_demand",
            "to_variable": "network_dominance",
            "activity": "biases",
            "from_level": "environmental",
            "to_level": "neural",
            "bridging_quality": "moderate",
            "maturity": "hypothesized_from_component_studies",
            "notes": "High demand (distraction/task) suppresses DMN. Low demand (safety/quiet) allows DMN. 'Goldilocks' noise (70dB) allows DMN/ECN fluidity."
        }
    ],
    "scope_conditions": [
        "Applies to creative/knowledge work",
        "Requires agency (ability to move between zones)"
    ],
    "moderators": [
        "Task phase (Generation vs. Evaluation)",
