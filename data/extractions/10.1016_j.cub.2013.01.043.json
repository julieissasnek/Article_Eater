  "theory_commitments": [
    {
      "theory_name": "Bayesian Inference in Perception",
      "commitment_type": "proposes",
      "specific_claim": "The visual system combines multiple, often ambiguous and noisy, sensory cues with prior knowledge about the world in a statistically optimal (Bayesian) manner to form robust and accurate perceptions of depth, distance, and 3D space."
    },
    {
      "theory_name": "Optimal Cue Integration",
      "commitment_type": "assumes",
      "specific_claim": "The brain integrates information from different sensory cues by weighting them according to their reliability (inverse variance) to achieve a more precise estimate than any single cue could provide."
    }
  ],
  "mechanism_chain": {
    "description": "The brain integrates various visual depth cues, each providing noisy information, by weighting them according to their reliability and combining them with prior statistical knowledge about the environment to form a posterior probability distribution over possible depth/distance estimates. The percept corresponds to the mean or mode of this posterior distribution.",
    "steps": [
      {
        "step": 1,
        "from_construct": "Multiple visual depth cues (e.g., binocular disparity, texture gradients, motion parallax, vergence, accommodation, familiar size)",
        "to_construct": "Noisy sensory evidence for depth/distance",
        "mechanism_type": "perceptual",
        "evidence_strength": "direct"
      },
      {
        "step": 2,
        "from_construct": "Noisy sensory evidence + Prior knowledge about the statistics of the environment",
        "to_construct": "Integrated, statistically optimal estimate of depth/distance (posterior probability distribution)",
        "mechanism_type": "cognitive",
        "evidence_strength": "direct"
      },
      {
        "step": 3,
        "from_construct": "Integrated depth/distance estimate",
        "to_construct": "Perceived visual space (e.g., perceived distance, depth, size)",
        "mechanism_type": "perceptual",
        "evidence_strength": "direct"
      }
    ]
