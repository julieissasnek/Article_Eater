  "title": "A Note towards the Understanding of Lighting Quality",
  "authors": "R. J. Hawkes, D. L. Loe & E. Rowlands, 1979",
  "research_question": "To gain some understanding of the nature of lighting quality by evaluating qualitative aspects of different lighting situations.",
  "design_type": "within_subjects",
  "participants": {
    "n": 28,
    "description": "15 males and 13 females, age range 20 to 65 years (high proportion below 40 years), secretarial, technical and academic staff from the Bartlett School of Architecture and Planning, University College London.",
    "recruitment": "Staff from University College London"
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "A windowless office mock-up (10 ft x 15 ft x 8 ft high, 3m x 4.5m x 2.4m) furnished as a two-person office, equipped with six different types of dimmer-controlled luminaires (ceiling recessed, wall lighting, downlights, desk lights, light tracks with spotlights). 18 distinct lighting situations were created and presented.",
      "n_stimuli": 18,
      "source": "Experimental design and procedure, Table 2.1, Figure 2.1, 2.2, 2.3"
    }
  ],
  "measures": [
    {
      "construct": "Overall difference between lighting situations",
      "instrument": "Numerical rating scale (1-100 units, anchored by situations 1 & 2 as 100)",
      "type": "self_report"
    },
    {
      "construct": "Lighting quality (semantic differential)",
      "instrument": "15 semantic differential scales (e.g., Frugal-Lavish, Focused-Diffuse, Dim-Bright, Simple-Complex, Mysterious-Obvious)",
      "type": "self_report"
    },
    {
      "construct": "Horizontal illuminance",
      "instrument": "Photometer (measured at desk surface)",
      "type": "physiological"
    },
    {
      "construct": "Vertical illuminance",
      "instrument": "Photometer (measured at 4 ft height, facing subject's direction of sight)",
      "type": "physiological"
    },
    {
      "construct": "Mean spherical (scalar) illuminance",
      "instrument": "Photometer (average illuminance over a small sphere)",
      "type": "physiological"
    },
    {
      "construct": "Illumination vector",
      "instrument": "Photometer (magnitude of difference in illuminances on opposite sides of a flat surface)",
      "type": "physiological"
    },
    {
      "construct": "Vector/scalar ratio",
      "instrument": "Calculated from illumination vector and mean spherical illuminance",
      "type": "physiological"
    },
    {
      "construct": "Mean cylindrical illuminance",
      "instrument": "Photometer (average luminance over curved surface of a small cylinder)",
      "type": "physiological"
    },
    {
      "construct": "Equivalent Sphere Illuminance (ESI)",
      "instrument": "Eastman contrast threshold visibility meter (at desktop level)",
      "type": "physiological"
    },
    {
      "construct": "Vertical illuminance (+50\u00b0)",
      "instrument": "Photocell with acceptance angle of \u00b150\u00b0 about the normal to the photocell surface",
      "type": "physiological"
    },
    {
      "construct": "Visual comfort probability (VCP)",
      "instrument": "Calculated (percentage of observers judging situation comfortable)",
      "type": "self_report"
    },
    {
      "construct": "Total energy consumption",
      "instrument": "Watts (measured for each situation)",
      "type": "physiological"
    },
    {
      "construct": "Preference rating",
      "instrument": "Sum of judgments on pleasant-unpleasant and attractive-unattractive semantic differential scales",
      "type": "self_report"
    }
  ],
