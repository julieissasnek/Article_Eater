  "title": "Optic flow based perception of two-dimensional trajectories and the effects of a single landmark.",
  "authors": "R.J.V. Bertin, I. Isra\u00ebl, 2000",
  "research_question": "Can human subjects integrate instantaneous perceptions of heading over time to reconstruct a 2D trajectory simulated by optic flow, and how does a single landmark affect this perception and reconstruction?",
  "design_type": "within_subjects",
  "participants": {
    "n": 16,
    "description": "8 men and 8 women, middle 20s to early 60s, normal or corrected-to-normal vision, naive to experiment purpose. An additional 16 subjects (6 female, 10 male, 8 of whom participated in experiments 1,2,3) participated in a control experiment.",
    "recruitment": "not stated"
  },
  "stimuli_or_exposures": [
    {
      "type": "VR",
      "description": "Optic flow stimuli simulating 2D manoeuvres (linear or curvilinear trajectories) over a horizontal ground plane. Environment consisted of 4800 white dots (4 pixel diameter) on a 50x50m ground surface 1m below eye-level, horizon at 15m. Manoeuvres had 3 degrees of freedom: linear/semicircular trajectories, with simulated whole-body orientation fixed in space, fixed relative to path, or changing relative to both. Stimuli included yaw (\u03a8o) and path rotation (\u03a8p). Triangular velocity profiles (0 to peak at 4s).",
      "n_stimuli": null,
      "source": "Methods, Table 1"
    },
    {
      "type": "VR",
      "description": "Single landmark: a red dot attached to the ground surface via a string of equally spaced blue dots. Landmarks were either 'shifting' (moved through observer's field of view, fixed in 3D space) or 'fixated' (red dot stationary in middle of screen, simulated movement in depth relative to landmark, eye-level, horizontal eye movements).",
      "n_stimuli": null,
      "source": "Methods, Simulated manoeuvres"
    }
  ],
  "measures": [
    {
      "construct": "Perceived manoeuvre reproduction",
