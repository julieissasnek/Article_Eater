      "construct": "Absolute detection sensitivity",
      "instrument": "Bayesian adaptive Psi procedure (inverse detection threshold contrast)",
      "type": "behavioral"
    },
    {
      "construct": "Discrimination sensitivity",
      "instrument": "Bayesian adaptive Psi procedure (inverse discrimination threshold for amplitude spectrum slope differences in a 4AFC 'odd-one-out' task)",
