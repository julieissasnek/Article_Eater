  "title": "Beauty and the beholder: the role of visual sensitivity in visual preference",
  "authors": "Branka Spehar et al., 2015",
  "research_question": "To explore whether observers' preference for visual patterns is related to their sensitivity for such patterns, specifically if preferred images contain structure to which the human visual system is most sensitive.",
  "design_type": "within_subjects",
  "participants": {
    "n": null,
    "description": "Experiment 1a: 22 undergraduate and postgraduate psychology students (age 17-30 years, normal or corrected-to-normal vision, naive to purpose). Experiment 1b: 46 undergraduate psychology students (16 males, 30 females, age 17-30 years, normal or corrected-to-normal vision, naive to purpose, none from Exp 1a). Experiment 2: 29 first-year psychology students (age 17-44 years, normal or corrected-to-normal vision, naive to purpose, none from previous experiments).",
    "recruitment": "Course credit (Exp 1a, 1b, 2), financial compensation (12 participants in Exp 2)."
  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "Grayscale images constructed from random noise, Fourier transformed, with amplitude frequency spectrum adjusted to create a range of spectral slopes (alpha values). Exp 1a used Series 1 (0.1, 0.4, 0.7, 1.0, 1.3, 1.6) and Series 2 (0.2, 0.5, 0.8, 1.1, 1.4, 1.7). Exp 1b used alpha values of 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5. All images had same mean luminance and RMS contrast (0.25 for illustration, 0.30 for preference tasks).",
      "n_stimuli": 12,
      "source": "Figure 1, Figure 4, Methods"
    },
    {
      "type": "photograph",
      "description": "Gaussian enveloped sine-wave gratings with peak spatial frequency ranging from 0.25, increasing in multiples of two, to 16 cycles per viewing degree. Phase was randomised.",
      "n_stimuli": 7,
      "source": "Figure 8, Methods"
    }
  ],
  "measures": [
    {
      "construct": "Visual preference",
      "instrument": "Two alternative forced-choice (2AFC) paired comparison procedure (proportion of trials image was chosen)",
      "type": "self_report"
    },
