  "title": "Embodied learning using a tangible user interface: The effects of haptic perception and selective pointing on a spatial learning task",
  "authors": "Alexander Skulmowski et al., 2016",
  "research_question": "To investigate whether additional haptic input (via a tangible user interface) and interactive label presentation (selective pointing vs. permanent display) are beneficial when learning with 3D objects, specifically heart anatomy.",
  "design_type": "between_subjects",
  "participants": {
    "n": 96,
    "description": "University students (Mage = 23.9 years, SDage = 3.43; 65 female, 31 male) predominantly in Media Communication and Psychology at a German university. 94 native German speakers. 84 right-handed, 9 ambilateral, 3 left-handed. All had normal or corrected-to-normal vision. Excluded those with recent heart anatomy learning or dyslexia.",
    "recruitment": "Received course credit or 6 € for participation."
  },
  "stimuli_or_exposures": [
    {
      "type": "3D_model",
      "description": "A 3D model of a human heart with 21 floating labels. Interacted with either a standard computer mouse or a Tangible User Interface (TUI). The TUI was a life-size plastic heart model (200g) with a motion sensor and a stylus pen.",
      "n_stimuli": 1,
      "source": "Figure 1, p.67"
    }
  ],
  "measures": [
    {
      "construct": "Prior knowledge of heart anatomy",
      "instrument": "Multiple choice test (5 questions) and oral interview",
      "type": "cognitive"
    },
    {
      "construct": "Spatial ability",
      "instrument": "Mental cube rotation test (Intelligence-Structure-Test I-S-T 2000R)",
      "type": "cognitive"
    },
    {
      "construct": "Learning performance (retention)",
      "instrument": "Visual retention test (labeling 3D heart model from front and back side, 31 items)",
      "type": "performance"
    },
    {
      "construct": "Learning performance (transfer)",
      "instrument": "Three transfer tasks (two cross-sections of 3D model, heart CT scan labeling, 22 items total)",
      "type": "performance"
    },
    {
      "construct": "Cognitive load",
      "instrument": "Cognitive load questionnaire (Eysink et al., 2009) with scales for intrinsic, extraneous, germane, and overall load (9-point scale, 6 items for agreement, 3 for extraneous load)",
      "type": "self_report"
    },
    {
      "construct": "Motivation",
      "instrument": "QSM/FAM questionnaire (Rheinberg et al., 2001) with scales for 'interest', 'efficacy', and 'challenge' (7-point scale, 13 items)",
      "type": "self_report"
    },
    {
      "construct": "Usability",
      "instrument": "AttrakDiff questionnaire (Hassenzahl et al., 2003) with scales for 'hedonic quality - stimulation' and 'pragmatic quality' (7-point scale, 15 items)",
      "type": "self_report"
    }
  ],
