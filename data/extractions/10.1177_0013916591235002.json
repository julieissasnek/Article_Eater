  "title": "EFFECTS OF SIGNAGE AND FLOOR PLAN CONFIGURATION ON WAYFINDING ACCURACY",
  "authors": "Michael J. O'Neill, 1991",
  "research_question": "This study examines the influence of floor plan complexity and several types of signage on wayfinding within a series of buildings on a university campus, specifically: (b) to examine the influence of floor plan complexity on observed wayfinding performance; (c) to investigate the influence of different types of signage on wayfinding performance; and (d) to determine whether there is an interaction between floor plan complexity and the presence and type of signage on wayfinding.",
  "design_type": "between_subjects",
  "participants": {
    "n": 55,
    "description": "21 females and 34 males, primarily undergraduate students from a university campus. Participants had an average of 3.6 times (SD=1.3) prior experience in the experimental buildings.",
    "recruitment": "Volunteers"
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Five distinct floor plan configurations (Settings 1-5) on a university campus, schematized from existing buildings and manipulated forms. These varied in topological complexity (Inter-Connection Density, ICD) from 1.00 (Setting 1) to 1.75 (Setting 5).",
      "n_stimuli": 5,
      "source": "Figure 2, p. 558-559"
    },
    {
      "type": "physical_space",
      "description": "Three signage conditions: no signage, textual signage ('Turn Left Here,' 'Turn Right Here,' 'Destination ahead'), or graphic signage (arrow indicating direction). Signs were 8x16 inch white foam core board, mounted near decision points at 5 ft 6 in height.",
      "n_stimuli": 3,
      "source": "p. 561"
    }
  ],
  "measures": [
    {
      "construct": "Rate of travel",
      "instrument": "Measured in feet per second by experimenter observation.",
      "type": "behavioral"
    },
    {
      "construct": "Backtracking",
      "instrument": "Ordinal Likert-type scale (1-5) scored by experimenter observation, defined as retracing a path in the opposite direction.",
      "type": "observational"
    },
    {
      "construct": "Stopping and looking",
      "instrument": "Ordinal Likert-type scale (1-5) scored by experimenter observation, defined as hesitating or stopping to look at signage or for orientation.",
      "type": "observational"
    },
    {
      "construct": "Wrong turns",
      "instrument": "Ordinal Likert-type scale (1-5) scored by experimenter observation, defined as making a turn incongruent with the most efficient path.",
      "type": "observational"
    }
  ],
