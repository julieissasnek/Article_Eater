  "components": [
    {
      "name": "The Architectural Coding System (TACS)",
      "description": "An instrument developed to code 59 discrete exterior physical features of architectural structures across 10 categories: overall form, roof, walls, wall appearance, wall textures, wall patterns, windows, amenities, ornaments, and context. Features are observable physical elements that can be counted or estimated.",
      "validation": "25 out of 59 cues demonstrated acceptable interrater reliability (ICC >= .70) in this study."
    },
    {
      "name": "Emotion Circumplex",
      "description": "A graphic circumplex method for eliciting emotional responses, representing pleasure on the horizontal plane (ugly to beautiful) and arousal on the vertical plane (arousing to unarousing). Participants mark a spot on the circumplex to indicate the nature and strength of their emotional response.",
      "validation": "Similar to methods developed and validated by Russell, Weiss, and Mendelsohn (1989). Participants underwent training and their ratings were checked against verbal statements for understanding."
    },
    {
      "name": "Global Impression Scale",
      "description": "A 10-point scale used by judges to rate each building based on their own standards, ranging from 1 (terrible architecture) to 10 (excellent architecture).",
      "validation": "Demonstrated acceptable interrater reliability (ICC = .85 for laypersons, .83 for architects) in this study."
    }
  ],
  "psychometric_properties": {
    "reliability": "TACS: 25 out of 59 cues had interrater reliability (ICC) >= .70. Laypersons' ratings: Pleasure ICC = .69, Arousal ICC = .75, Global Impression ICC = .85. Architects' ratings: Pleasure ICC = .72, Arousal ICC = .62, Global Impression ICC = .83.",
    "validity": "The Emotion Circumplex is based on a previously validated method (Russell, Weiss, & Mendelsohn, 1989). Training and verbal checks were used to ensure participant understanding."
  },
  "recommended_use": "The lens model framework can be used to identify specific physical features and emotional responses underlying differences in aesthetic assessments between groups (e.g., architects and laypersons). This information can help architects predict lay responses, increase lay satisfaction, educate laypersons about architectural preferences, and promote understanding of the bases for preferences for various built forms.",
  "domains": [
    "A6_Visual_Form",
    "A9_Task_Cognition"
  ],
  "overall_theory_links": [
    "DP",
    "IC",
    "PP"
  ],
  "limitations": [
    "Complete uniformity in photographic angle and style of building images could not be attained.",
    "Not all 59 TACS cues could be reliably rated; those that failed often had little variability or were unclear in the photographs.",
    "The 25 physical cues examined did not fully explain laypersons' pleasure ratings, suggesting other unmeasured cues may be important.",
    "The study did not investigate more abstract conceptualizations of buildings (e.g., styles, prototypes, schemas) which may influence aesthetic assessments."
  ],
