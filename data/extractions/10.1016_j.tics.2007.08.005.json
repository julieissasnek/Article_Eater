  "participants": {
    "n": 36,
    "description": "Undergraduate students from the University of California, San Diego.",
    "recruitment": "Volunteered in response to a campus advertisement (Experiments 1, 2A, 2B) or participated as part of a course requirement (Experiment 3)."
