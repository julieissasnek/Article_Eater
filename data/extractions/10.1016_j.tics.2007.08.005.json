  "stimuli_or_exposures": [
    {
      "type": "plan_drawing",
      "description": "Experiment 1: 5 real-world geographical location pairs (e.g., Portland, Ore. to Toronto) and 15 filler pairs, presented on separate pages with a circle and 'N' for north. The test pairs were chosen such that their geographical direction differed from the general direction of their superordinate political or geographical units.",
      "n_stimuli": 20,
      "source": "Methods, p.423"
    },
    {
      "type": "plan_drawing",
      "description": "Experiment 2A: Prototypical maps (21.6 \u00d7 21.6 cm) with two key cities ('x', 'y') and one filler city ('z'). Conditions: Homogenous (single unit), Congruent (superordinate unit direction matches city direction), Incongruent (superordinate unit direction opposite city direction). Tested for horizontal and vertical dimensions. Cities labeled with letters, counties with Greek letters. Small compass rose included.",
      "n_stimuli": 12,
      "source": "Figure 2, Methods, p.425"
    },
    {
      "type": "plan_drawing",
      "description": "Experiment 2B: Similar maps to Experiment 2A, but county lines for incongruent condition were precisely vertical (except curved part between key cities). Homogenous condition included a non-interfering county line. An extra city was added (total 4 cities). Cities labeled with animal names for counties.",
      "n_stimuli": 12,
      "source": "Methods, p.427"
    },
    {
      "type": "plan_drawing",
      "description": "Experiment 3: Maps with straight boundaries, two counties (labeled with Midwestern US towns). Two superordinate directions (East-West, North-South). Key city directions deviated from superordinate by 15, 45, or 75 degrees (clockwise/counter-clockwise). Each map contained two filler cities.",
      "n_stimuli": 24,
      "source": "Figure 3, Methods, p.429"
    }
  ],
  "measures": [
