      "source": "Figure 2, Methods section"
    },
    {
      "type": "physical_space",
      "description": "Experiment 1: Indoor lighting conditions varied by illuminance (300 lx vs 1500 lx) and colour temperature ('warm' white 3000K vs 'cool' white 4000K) at high Colour Rendering Index (CRI=95).",
      "n_stimuli": 4,
      "source": "Methods section"
    },
    {
      "type": "physical_space",
      "description": "Experiment 2: Indoor lighting conditions varied by illuminance (300 lx vs 1500 lx) and colour temperature ('warm' white 2950K vs 'cool' white 4200K) at low Colour Rendering Index (CRI=51-58).",
      "n_stimuli": 4,
      "source": "Methods section"
    }
  ],
  "measures": [
