  "title": "The effects of illuminance on students' memory. A neuroarchitecture study",
  "authors": "Nuria Castilla et al., 2023",
  "research_question": "To analyse the effect that a classroom's illuminance exerts on university students' memories, considering both psychological (memory task) and neurophysiological responses (EEG, HRV, and EDA).",
  "design_type": "within_subjects",
  "participants": {
    "n": 142,
    "description": "58% male, 42% female; average age 23.17 years (σ = 4.04). Participants were Spanish university students (18-23 years old) with normal or corrected-to-normal vision (contact lenses) and no colour deficiencies, and had not consumed performance-altering substances in the previous 24 hours.",
    "recruitment": null
  },
  "stimuli_or_exposures": [
    {
      "type": "VR",
      "description": "Three immersive virtual environments (IVEs) simulating a university classroom, each with a different illuminance level: 100 lx, 300 lx, and 500 lx. The IVEs were rendered as 360° panoramas and displayed via an HTC Vive HMD.",
      "n_stimuli": 3,
      "source": "Abstract, 2.2. IVE, 2.3. Illuminance configurations"
    }
  ],
  "measures": [
    {
      "construct": "Sense of presence",
      "instrument": "SUS questionnaire (6 items, 7-point Likert scale)",
      "type": "self_report"
    },
    {
      "construct": "Memory performance",
      "instrument": "Psychological memory task (similar to Deese-Roediger-McDermott (DRM) paradigm, recall of 15-word lists, 'memory-correct answers' metric)",
      "type": "performance"
    },
    {
      "construct": "Alertness / Brain activity (frontal highbeta band)",
      "instrument": "EEG (b-Alert x10 device, Fz electrode, highbeta band 21-30 Hz, relative power)",
      "type": "neural"
    },
    {
      "construct": "Sympathetic system activity / Arousal",
      "instrument": "HRV (b-Alert x10 device, low frequency band 0.05-0.15 Hz, normalized units, HRV-nLF)",
      "type": "physiological"
    },
    {
      "construct": "Emotional arousal / Sympathetic system activity",
      "instrument": "EDA (Shimmer 3GSR+ device, phasic component, normalized values, EDA-Phasic)",
      "type": "physiological"
    }
  ],
