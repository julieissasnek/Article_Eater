  "title": "Exploring the Impact of Accessibility on Place Attachment in Urban Public Open Spaces: A Case Study of Jiamusi City, China",
  "authors": "Jun Zhang et al., 2024",
  "research_question": "To explore the impact of accessibility on place attachment within urban public open spaces, specifically by systematically analyzing the complex relationship between perceptual accessibility, spatial accessibility, place satisfaction, and place attachment.",
  "design_type": "cross_sectional",
  "participants": {
    "n": 327,
    "description": "Residents of Jiamusi City, China, who had lived in the study area for at least one month and had a basic understanding of their neighborhood. Demographics: 57.19% female, main age groups 21-30 and 41-50 (24.16% each), 69.11% college degree or above, 28.44% monthly income 3000-5000 yuan, 64.83% residency length >10 years.",
    "recruitment": "Face-to-face (randomly distributed in 11 selected public open spaces) and online (WeChat app Questionnaire Star)."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "11 selected urban public open spaces (POS) in the main urban area of Jiamusi City, China, including parks, botanical gardens, and squares.",
      "n_stimuli": 11,
      "source": "Figure 2, Section 3.2"
    }
  ],
  "measures": [
    {
      "construct": "Spatial Accessibility",
      "instrument": "Gaussian two-step moving search method (calculated for walking, cycling, and car travel based on road networks, POS locations, and population data)",
      "type": "computational"
    },
    {
      "construct": "Perceived Accessibility",
      "instrument": "Questionnaire (19 factors across User Demand, Travel Cost, Spatial Attractiveness dimensions, 5-point Likert scale)",
      "type": "self_report"
    },
    {
      "construct": "Place Satisfaction",
      "instrument": "Questionnaire (16 items across Comfort, Convenience, Pleasure, Safety dimensions, 5-point Likert scale)",
      "type": "self_report"
    },
    {
      "construct": "Place Attachment",
      "instrument": "Place Attachment Scale (Williams and Vaske, optimized, 2 dimensions: Place Dependence, Place Identity, 5-point Likert scale)",
      "type": "self_report"
    }
  ],
