  "synthesis_conclusions": [
    "Higher illuminances, contrast ratios (7-11:1), and higher CCTs generally improve task performance.",
    "Spectral tuning (red or blue light) shows positive effects on alertness and cognitive performance.",
    "The impact of lighting conditions on performance is evident, but small sample sizes and varied conditions limit meta-analyses for concrete design recommendations.",
    "Daylight and outside view, when properly controlled, can play an important role in task performance.",
    "Vertical illuminance on the eye is more important for computer-based tasks than horizontal illuminance and should be emphasized in future studies."
  ],
  "evidence_gaps": [
    "Vertical illuminance should be investigated as more appropriate for computer-related tasks.",
    "Daylight has not been thoroughly studied compared to electric lighting.",
    "Glare implications of excessive illuminance levels need to be considered.",
    "Inconsistencies between luminance studies suggest the need for larger data sets and consistent experimental protocols that will allow meta-analyses of combined data sets.",
    "More studies are needed to better understand the interaction of color and light levels with respect to performance.",
    "Further research is needed with respect to the impact of the duration of color interventions.",
    "The acceptability of non-widely-used color temperatures needs to be investigated to prove the feasibility of relevant interventions in design.",
    "Controlled studies are needed to validate the indications of aspects of outside view impacting learning and cognitive performance.",
    "Robust rules and validated questions for subjective task performance evaluation are needed.",
    "The long-term effects of spectrally-tuned lighting on task performance are still under investigation."
  ],
  "risk_of_bias_assessment": null,
  "heterogeneity_sources": [
    "Individual differences among participants",
    "Small sample sizes in primary studies",
    "Varied experimental conditions and methodologies across studies",
    "Human variability and hidden factors"
  ],
  "publication_bias": null,
  "moderators": [
    {
      "variable": "Adaptation time",
      "effect": "Higher adaptation time reflects more realistic conditions and potentially shows more valid results, but studies designed to include adaptation period before tasks showed a more trivial illuminance effect on performance.",
      "significant": true,
      "subgroup_effects": null
    },
    {
      "variable": "Age of office workers",
      "effect": "Older subjects (46-62 years old) showed performance deterioration more quickly as illuminance was reduced, compared to younger subjects (18-22 years old).",
      "significant": true,
      "subgroup_effects": null
    },
    {
      "variable": "Type of task (computer vs. paper work)",
      "effect": "The type of task should be carefully considered as it influences the relevance of horizontal vs. vertical illuminance.",
      "significant": true,
      "subgroup_effects": null
    }
  ],
