  "title": "Reducing the Stress of High-Density Living: An Architectural Intervention",
  "authors": "Andrew Baum and Glenn E. Davis, 1980",
  "research_question_or_hypothesis": [
    "To test the efficacy of an architectural intervention as a stress reducer in high-density residences.",
    "To further examine the usefulness of a conceptualization of density and crowding, focusing on group formation and regulatory control of social interaction as primary mediators of crowding stress."
  ],
  "study_design": {
    "type": "quasi_experimental_field_study_with_lab_component",
    "longitudinal": true,
    "duration": "3-month period",
    "independent_variables": [
      "Dormitory architectural design (Long Corridor, Short Corridor, Long Corridor Intervention)"
    ],
    "dependent_variables": [
      "Perceived crowding",
      "Residential social problems",
      "Perceived control",
      "Group formation",
      "Motivation to achieve control",
      "Social activity in hallway",
      "Open bedroom doors",
      "Interpersonal distance",
      "Facial regard",
      "Discomfort",
      "Persistence on anagram task"
    ]
  },
  "participants": {
    "n_total": 67,
    "description": "First-year female students residing in long-corridor, short-corridor, and long-corridor-intervention dormitory floors. 54 subjects participated in the laboratory phase (18 in each group).",
    "recruitment": "Random assignment of residents to long- and short-corridor dormitories (for comparison groups). Intervention floor was a modified long-corridor floor."
  },
  "intervention": {
    "type": "architectural modification",
    "description": "The second floor of a long-corridor dormitory was bisected by a three-room lounge area enclosed by unlocked doors. This converted three central bedrooms to lounge space, reducing the number of residents on this floor from 43 to 39, and reducing the number of people sharing bathroom and hallway space, effectively creating two groups of about 20 residents instead of one group of 40.",
    "duration": "Summer preceding investigation"
  },
  "measures": [
    {
      "name": "Perceived Control (Survey)",
      "type": "self_report",
      "details": "5- and 7-point scales assessing feelings of control in the dormitory, predictability of dormitory life, and ability to regulate social contact."
    },
    {
      "name": "Group Formation (Survey)",
      "type": "self_report",
      "details": "Questions on likelihood of small groups forming, success in making friends, and knowing neighbors as friends."
    },
    {
      "name": "Perceived Crowding (Survey)",
      "type": "self_report",
      "details": "Rating of how crowded dormitory life was."
    },
    {
      "name": "Motivation to Achieve Control (Survey)",
      "type": "self_report",
      "details": "Agreement/disagreement with statements like 'worthwhile to try to structure your interaction' and 'not worth the effort to try to change the way things are'."
    },
    {
      "name": "Social Activity (Observation)",
      "type": "behavioral_observation",
      "details": "Percentage of hallway activity classified as social (two or more people interacting) during week nights (10:00-11:00 p.m.)."
    },
    {
      "name": "Open Bedroom Doors (Observation)",
      "type": "behavioral_observation",
      "details": "Number of bedroom doors left open during 15-minute observation periods."
    },
    {
      "name": "Interpersonal Distance (Laboratory)",
      "type": "behavioral_observation",
      "details": "Seat position relative to a confederate in a waiting room."
    },
    {
      "name": "Facial Regard (Laboratory)",
      "type": "behavioral_observation",
      "details": "Number of seconds spent looking at the face or eyes of a confederate."
    },
    {
      "name": "Discomfort (Laboratory)",
      "type": "self_report",
      "details": "7-point scale rating discomfort after a 5-minute waiting period."
    },
    {
      "name": "Perceived Control over Lab Session (Laboratory)",
      "type": "self_report",
      "details": "Rating of expected control over the experimental session."
    },
    {
      "name": "Anagram Task Persistence (Laboratory)",
      "type": "behavioral_performance",
      "details": "Number of difficult anagram trials attempted."
    }
  ],
  "statistical_analysis": "Multivariate analyses of variance (MANOVA), univariate F-tests, Tukey contrasts.",
