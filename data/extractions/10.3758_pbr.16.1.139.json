  "theory_commitments": [
    {
      "theory_name": "Irrelevant Sound Effect (ISE)",
      "commitment_type": "tests",
      "specific_claim": "Irrelevant auditory stimuli, particularly those with changing-state properties, disrupt performance on tasks requiring serial recall by interfering with the phonological loop."
    },
    {
      "theory_name": "Working Memory Theory (e.g., Baddeley & Hitch)",
      "commitment_type": "extends",
      "specific_claim": "Individual differences in central executive functions, such as deliberate sequence processing (recoding), can modulate susceptibility to auditory distraction by influencing how irrelevant sound is processed."
    }
  ],
  "mechanism_chain": {
    "description": "The paper investigates how individual differences in deliberate sequence processing (recoding) ability influence susceptibility to auditory distraction. It proposes that individuals with higher recoding ability might be more prone to processing irrelevant auditory sequences, leading to greater interference with a primary task.",
    "steps": [
      {
        "step": 1,
        "from_construct": "Irrelevant changing-state auditory stimuli (e.g., speech)",
        "to_construct": "Automatic capture of attention and processing of auditory sequence",
        "mechanism_type": "perceptual",
        "evidence_strength": "direct"
      },
