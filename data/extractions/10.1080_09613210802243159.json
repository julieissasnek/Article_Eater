  "components": [
    {
      "name": "Time-segmentation method",
      "description": "Splits the year into a small number of periods, averaging TMY2 data, sun positions, and weather conditions using the ASRC-CIE sky model to represent yearly and hourly intervals. Results in 28 unique sun positions at 56 times of year.",
      "validation": "Described and validated in Kleindienst et al. (2008); ASRC-CIE model validated by Littlefair (1994)."
    },
    {
      "name": "Temporal Maps",
      "description": "A highly graphical visualization format (Spatio-Temporal Irradiation Maps) displaying time-dependent numerical data (e.g., percentage of area fulfilling illuminance goals) to represent annual variation visually.",
      "validation": "Compared to full DAYSIM data, similar critical observations could be made with the simpler map."
    },
    {
      "name": "Goal-based metrics",
      "description": "Four types of metrics: 'Is there enough light?' (proportion of area meeting illuminance thresholds), 'Is there too much light?' (proportion of area within acceptable illuminance range or glare estimation via DGP), 'Is there excessive sun penetration?' (conceptual, estimates overheating risk from window illuminance), and 'Is the light distribution satisfying?' (conceptual, based on luminance distribution patterns and visual associations).",
      "validation": "Enough/Too much light metrics are defined; DGP is validated by Wienold and Christoffersen (2006); sun penetration and light distribution metrics are conceptual/under development."
    },
    {
      "name": "Interactive analysis interface",
      "description": "A prototype interface presenting interactive Temporal Maps and renderings from different camera viewpoints at different times of the year, allowing users to navigate and compare design iterations and conditions. Includes animations and a comparison panel.",
      "validation": "Initial testing by architecture students showed promise and positive reactions."
    },
    {
      "name": "Interactive global illumination rendering method",
      "description": "A hybrid system combining shadow volumes for direct sun illumination, forward ray-tracing for sky illumination, and a radiosity-based method on a coarse grid for indirect illumination. Designed to model conventional and advanced window technologies.",
      "validation": "Renderings are visually almost indistinguishable from Radiance, with <10% error in pixel-by-pixel luminance values; rapid performance (real-time viewpoint changes, ~1s re-lighting) (Cutler et al., 2008)."
    },
    {
      "name": "Expert system for design optimization",
      "description": "A computer-based system that uses a Design of Experiments (DoE) approach to establish 'Expert Rules'. It generates iterative design improvement suggestions by narrowing a list of possible strategies and determining exact values through traditional optimization, guiding the user towards fulfilling design goals.",
      "validation": null
    }
  ],
  "psychometric_properties": {
    "reliability": null,
    "validity": null
  },
  "recommended_use": "Interactive design support for architects and building engineers in the early stages of the design process, for evaluating annual daylighting potential, exploring design alternatives, learning about daylighting strategies, and creating project deliverables.",
  "domains": [
    "A4_Light",
    "A9_Task_Cognition",
