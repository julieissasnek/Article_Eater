  "title": "The impact of auditory distraction on retrieval of visual memories",
  "authors": "Peter E. Wais et al., 2011",
  "research_question": "Does irrelevant auditory information impact objective recollection of visual details during episodic memory retrieval, and does environmental distraction induce domain-general interference that disrupts recollection?",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 27,
    "description": "Young adults (18-29 years old, 19 males), native speakers of English, healthy, no history of hearing/neurological/psychiatric disease, normal/corrected-to-normal vision. One participant was excluded from the initial N=28.",
    "recruitment": "Recruited from the university community"
  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "168 target images, each displaying one to four copies of the same object from a three-dimensional perspective, in color, on a plain white background. Objects were common items, controlled for concreteness and namability.",
      "n_stimuli": 168,
      "source": "Method - Stimuli"
    },
    {
      "type": "audio",
      "description": "Auditory stimuli presented via sound-canceling headphones: (1) complete silence (headphones off), (2) white noise (flat power spectral density), and (3) ambient sounds recorded at a busy café (restaurant chatter). All auditory stimuli were equated and normalized for power spectral density.",
      "n_stimuli": null,
      "source": "Method - Stimuli"
    }
  ],
  "measures": [
    {
      "construct": "Objective recollection of goal-relevant visual details",
      "instrument": "Conditional correct score (proportion of target responses for which individuals correctly recalled the count, given the item was not forgotten)",
      "type": "cognitive"
    },
    {
      "construct": "Hit rate",
      "instrument": "Proportion of targets in each condition that were given a count (correct or incorrect)",
      "type": "behavioral"
    },
    {
      "construct": "False alarm rate",
      "instrument": "Proportion of lures erroneously given an object count",
      "type": "behavioral"
    },
    {
      "construct": "Memory discrimination",
      "instrument": "d' (d-prime)",
      "type": "cognitive"
    },
    {
      "construct": "Strategy use",
      "instrument": "Verbal exit interview assessing use of visual imagery",
      "type": "self_report"
    }
  ],
