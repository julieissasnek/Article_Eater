  "title": "Wood in office spaces: The impact of different wooden furniture on aesthetic evaluation",
  "authors": "Zhu Y et al., 2023",
  "research_question": "How do wood color and wood coverage in office furniture impact the aesthetic evaluation (sensory evaluation, satisfaction, and usage willingness) of wooden office spaces?",
  "design_type": "between_subjects",
  "participants": {
    "n": 185,
    "description": "Adults aged 18-57 years (Mage = 28.37 \u00b1 7.83 years), 78 men, 107 women, from China. Participants worked or studied indoors for an average of 7.77 \u00b1 2.03 h per day, with an average of 6.21 \u00b1 8.31 years of work experience. 30.30% had college degrees or below, 50.30% bachelor's, 16.80% master's, and 2.7% doctoral degrees. All reported normal vision and no visual defects or color blindness.",
    "recruitment": "Recruited online via questionnaire.com platform"
  },
  "stimuli_or_exposures": [
    {
      "type": "video",
      "description": "Six 35-second videos (720 dpi resolution) depicting different wooden office spaces. The interior construction (ceiling, walls, floor, windows, lighting, object arrangement) remained consistent across conditions. Wood was applied to desk top, office chair seat surface, storage cabinet counter top and body, bookcase, and sofa stents. Conditions varied by wood color (light #ECCD97, medium #ECB36C, dark #95582C) and wood coverage (low 12%, high 35%).",
      "n_stimuli": 6,
      "source": "section 2.3.1"
    },
    {
      "type": "photograph",
      "description": "Four scene pictures (300 dpi resolution) for each of the six wooden office spaces, showing different angles, to assist participants in imagining themselves working in the space.",
      "n_stimuli": 24,
      "source": "section 2.3.2"
    }
  ],
  "measures": [
    {
      "construct": "Positive Affect",
      "instrument": "Positive Affect Negative Affect Scale (PANAS) - positive emotion dimension (e.g., active, enthusiastic, happy)",
      "type": "self_report"
    },
    {
      "construct": "Negative Affect",
      "instrument": "Positive Affect Negative Affect Scale (PANAS) - negative emotion dimension (e.g., shame, sadness, fear)",
      "type": "self_report"
    },
    {
      "construct": "Sensory Evaluation of Wooden Office Spaces",
      "instrument": "10 adjectives (bright, spacious, organized, relaxing, natural, harmonious, vivid, comfortable, beautiful, attractive) on a 7-point scale",
      "type": "self_report"
    },
    {
      "construct": "Satisfaction with Wooden Office Spaces",
      "instrument": "Two questions ('How satisfied are you with your office environment?', 'To what extent does this wooden furniture meet your demands...') on a 7-point scale",
      "type": "self_report"
    },
    {
      "construct": "Usage Willingness of Wooden Office Spaces",
      "instrument": "Two questions ('How much do you like to work here?', 'How willing are you to work here?') on a 7-point scale",
      "type": "self_report"
    }
  ],
