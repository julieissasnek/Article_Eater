  "title": "Physiological markers of visual environment comfort in the North",
  "authors": "N Zvyagina et al., 2019",
  "research_question": "To identify physiological markers of visual environment comfort of modern cities located in the polar and pre-polar regions of Russia.",
  "design_type": "within_subjects",
  "participants": {
    "n": 50,
    "description": "50 people aged 20 years without any visual and nervous systems pathology, from modern cities located in the polar and pre-polar regions of Russia.",
    "recruitment": null
  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "Five series of urban visual environment images, each presented for 30 seconds:\n1.  **Series I (Historic buildings)**: Constructions from 18-19 centuries, low-rise, Baroque/classical/Gothic style, with carved details, varied colors, natural lines.\n2.  **Series II (Modern buildings)**: Constructions from the last decade of the 21st century, high-tech/deconstructivism/postmodernism styles, monochrome slabs, mirror panels, minimalism, unusual forms.\n3.  **Series III (Homogeneous)**: Gable facades without windows or other elements (standard of uncomfortable visual environment).\n4.  **Series IV (Aggressive)**: Standardized multi-storey buildings with many identical windows (standard of uncomfortable visual environment).\n5.  **Series V (Comfortable)**: Images of nature (standard of comfortable visual environment).",
      "n_stimuli": null,
      "source": "2. Main Text, p.2-4"
    }
  ],
  "measures": [
    {
      "construct": "Oculo-motor reactions (eye tracking)",
      "instrument": "iView XTM RED (Remote Eyetracking Device)",
      "type": "behavioral"
    },
    {
      "construct": "Autonomic Nervous System (ANS) response (Caused Skin Vegetative Potential - CSVP)",
      "instrument": "ANS-spectrum apparatus",
      "type": "physiological"
    }
  ],
