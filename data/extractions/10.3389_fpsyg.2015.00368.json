  "components": [
    {
      "name": "Systematic experimental approach to exposure",
      "description": "Specify visual salience (number, size, species, location, activities) based on theory and previous work to aid accumulation of findings.",
      "validation": null
    },
    {
      "name": "Manipulation or measurement of exposure duration",
      "description": "Allow sufficient time for specified effects to emerge and open for description of dose-response relations.",
      "validation": null
    },
    {
      "name": "Ensuring potential for restoration",
      "description": "Ensure participants have some need or potential for restoration (e.g., attentional fatigue, stress induction, or naturally occurring needs).",
      "validation": null
    },
    {
      "name": "Addressing gender moderation",
      "description": "Design experiments that address a priori hypotheses regarding gender moderation.",
      "validation": null
    },
    {
      "name": "Measurement standardization",
      "description": "Adopt previously used measures in new studies to move towards a standard measurement kit.",
      "validation": null
    },
    {
      "name": "Measuring mediating processes",
      "description": "Measure variables that represent the mediating process(es) invoked (e.g., fascination for restorative effects) and perform formal tests of mediation.",
      "validation": null
    },
    {
      "name": "Detailed reporting of methods",
      "description": "Provide useful descriptions of interventions including number, species, height, type of plants, containers, placement, photos, floor plans, environmental details (lighting, air quality), exposure length, and participant activities.",
      "validation": null
    },
    {
      "name": "Adherence to statistical reporting guidelines",
      "description": "Attend to statistical reporting guidelines (e.g., APA Task Force), including effect sizes or data for their calculation, even for non-significant effects, to facilitate meta-analytic work.",
      "validation": null
    }
  ],
