  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Two identical real-sized rooms (341 cm (l) \u00d7 320 cm (w) \u00d7 260 cm (h)). One room (wood, W) was built entirely with wooden boards of Norway spruce (Picea abies L., Karst) and Silver fir (Abies alba Mill.). The other room (not-wood, NW) was built by applying fibre-cement flat sheets to a wooden framework and by plastering and painting both walls and ceiling, with vinyl boards (LVT) for the floor. Both rooms had a window, ceiling lighting, desk with chair, floor lamp, convector heater, and coat rack. White curtains provided privacy. Temperature, humidity, and luminosity were monitored to ensure similar environmental conditions.",
      "n_stimuli": 2,
      "source": "Figure 2 and Methods section 2.2"
    },
    {
      "type": "other",
      "description": "Nine building material samples (11 cm x 16 cm pieces in white cardboard boxes with a 7 cm x 10 cm window for viewing and touching). Materials: light-colour spruce wood, dark-colour spruce wood, light-colour laminate, dark-colour laminate, light-colour wood-look ceramic, dark-colour wood-look ceramic, light-colour gres ceramic, white fibre cement, and dark-colour vinyl flooring.",
      "n_stimuli": 9,
      "source": "Figure 1 and Methods section 2.1"
    }
  ],
