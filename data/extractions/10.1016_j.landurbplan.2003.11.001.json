  "title": "Preferences for and attitudes towards street flowers and trees in Sapporo, Japan",
  "authors": "Assenna Todorova et al., 2004",
  "research_questions": [
    "Which of three factors (tree presence, plot type, and flower bed elements) is most influential on deciding preferences for different street-planting models?",
    "Which flower bed elements and type of flowers are most preferred?",
    "What are the attitudes of residents towards street flowers?"
  ],
  "hypotheses": [],
  "methodology": {
    "participants": "81 residents of Sapporo (25 students, 56 others; 52% men, 48% women; majority in their 20s, followed by self-owned detached housing residents, students as largest occupational group).",
    "design": "Mixed-methods, combining evaluation of photomontage simulations with a questionnaire survey.",
    "stimuli": "59 photomontage simulations of street-planting models, based on photographs taken in Sapporo residential areas (1999-2000). All photos had the same background, only planting models differed. Three experiments (A, B, C) varied tree presence, plot type (long/short), and flower bed elements/characteristics (soil, grass, hedge, flowers; color, height, arrangement, composition).",
    "measures": [
      "Preference ratings: 5-step rating scale ('strongly like' (5) to 'strongly dislike' (1)) for each photomontage.",
      "Attitude ratings: 14 structured items related to perceptions of and attitudes to street flowers, rated on a 5-step rating scale ('strongly agree' (5) to 'strongly disagree' (1)).",
      "Demographic characteristics: Occupation, gender, age."
    ],
    "analysis": [
      "General Linear Model (ANOVA) for preferences, investigating influence of plot, trees, and their interactions.",
      "Scheffe's multiple comparison procedure (P < 0.05) for mean score comparisons.",
      "t-test for differences in preferences based on personal characteristics (occupation, gender, age).",
      "Factor analysis (Varimax rotation, principal components, eigen values > 1) for attitude variables."
    ]
  },
