  "title": "Highlight-shading relationship as a cue for the perception of translucent and transparent materials",
  "authors": "Isamu Motoyoshi, 2010",
  "research_question": "What image features are diagnostic of the perceived translucency and transparency of 3D objects, focusing on how variations in opacity affect the non-specular component (shading pattern) but not the specular component (highlights)?",
  "design_type": "within_subjects",
  "participants": {
    "n": 9,
    "description": "Experiment 1: 8 naive paid volunteers (5 females, 3 males) and the author (male), average age 29.4 (SD = 5.4) years old, with normal or corrected-to-normal vision. Experiment 2: 7 subjects, all of whom participated in Experiment 1.",
    "recruitment": "Paid volunteers"
  },
  "stimuli_or_exposures": [
    {
      "type": "rendering",
      "description": "Computer-generated 3D objects (Bust, Lion, Buddha, Dragon) with complex shapes, rendered with two types of natural illumination (Debevec's 'Eucalyptus' and 'Building' light-probe images). For Experiment 1, objects had 9 different opacity settings (6 variable sub-surface scattering depths: 0, 0.13, 0.25, 0.5, 1, 2 m; 3 variable transparencies: 25%, 50%, 100% in addition to 2m scattering). For Experiment 2, opaque objects from Exp 1 were used, and their non-specular component was decomposed into low and high spatial frequency bands, with each sub-band's contrast independently multiplied by factors (1.0, 0.6, 0.3, 0.0, -0.3, -0.6), while highlights remained intact.",
      "n_stimuli": 72,
      "source": "Methods, Figure 1, Figure 5"
    }
  ],
  "measures": [
    {
      "construct": "Apparent translucency/transparency",
      "instrument": "Five-point rating scale (0: opaque, 1-2: translucent like marble or wax, 3-4: highly translucent like jelly or glass)",
      "type": "self_report"
    }
  ],
