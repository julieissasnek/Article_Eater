  "title": "Visual effects of wood on thermal perception of interior environments",
  "authors": "Denise Blankenberger et al., 2019",
  "research_question": "To quantify human perception of thermal comfort of wood materials in a controlled laboratory setting, specifically exploring the impact of wood materials on perceived thermal comfort in the cooling season, perceived subjective qualities of wood materials, and physiological associations of wood materials as indicators of stress response.",
  "design_type": "between_subjects",
  "participants": {
    "n": 56,
    "description": "56 participants (20 female, 36 male) from University of Oregon in Portland and Portland State University. Wood group (n=28): Age 29 +/-11.5, BMI 24.2 +/-4.8. Gypsum group (n=28): Age 33 +/-10.8, BMI 22.5 +/-3.8. No significant vision impairment, heart condition, or illness reported.",
    "recruitment": "Recruited from University of Oregon in Portland and Portland State University."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "A climate chamber (8'x12'x9') with controlled radiant temperature, air temperature, humidity, and airflow. Wall treatments were reversible panels: (1) unfinished laminated Douglas fir wood (Light reflectance value ~52) and (2) white-painted gypsum board (Benjamin Moore #2022-70, Light reflectance value 89.27). A black fabric curtain covered walls during acclimation. Floor was gray laminate tile, ceiling white-painted aluminum panels. Electric lighting (3500 Kelvin) was used. Thermal environment maintained at +0.5 PMV (81.5°F±1°F, 40%RH±5%).",
      "n_stimuli": 3,
      "source": "1.2. Setting, 1.3. Thermal environment and equipment, Figure 1"
    }
  ],
  "measures": [
    {
      "construct": "Thermal Sensation (TS)",
      "instrument": "ASHRAE seven-point scale (cold to hot, neutral as middle)",
      "type": "self_report"
    },
    {
      "construct": "Thermal Acceptability (TA)",
      "instrument": "5-point scale ('clearly unacceptable' to 'clearly acceptable')",
      "type": "self_report"
    },
    {
      "construct": "Thermal Preference (TP)",
      "instrument": "3-point McIntyre scale ('cooler', 'no change', 'warmer')",
      "type": "self_report"
    },
    {
      "construct": "Temperature Estimation (TE)",
      "instrument": "Open-ended (°F or °C)",
      "type": "self_report"
    },
    {
      "construct": "Perceived qualities of wall treatments",
      "instrument": "Semantic-differential survey (16 word pairs, 7-point bipolar scale)",
      "type": "self_report"
    },
    {
      "construct": "Blood pressure",
      "instrument": "Ambulatory blood pressure monitor (Oscar 2, SunTechMedical)",
      "type": "physiological"
    },
    {
      "construct": "Internal body temperature",
      "instrument": "In-ear clinical thermometer (Braun ThermoScan)",
      "type": "physiological"
    }
  ],
