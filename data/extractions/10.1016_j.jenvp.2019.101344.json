  "synthesis_conclusions": [
    "There is currently no standard, accepted, cross-validated protocol or methodology for evaluating how design of built environments affects neurophysiological correlates of emotion in humans.",
    "The body of evidence does not provide robust evidence for the neurophysiological effect of different visual properties of the built environment in interior spaces.",
    "The field suggests that emotional state is affected by visual properties that can be objectively measured, resulting in neural and physiological activity.",
    "Brain and body activity in response to design characteristics can occur without conscious perception.",
    "Knowledge and measurability of these impacts may lead to new standards for evaluating built environments."
  ],
  "evidence_gaps": [
    "No studies reported on the effect of colour, scale or proportion.",
    "Limited number of studies conducted in this field.",
    "Studies have small sample sizes with little diversity in participants (e.g., age, cultural background).",
    "Broad array of methodological and reporting procedures being used, hindering synthesis.",
    "No studies reported effect size, preventing meta-analysis.",
    "Lack of consistency in data analysis procedures.",
    "Inconsistent data representation methods.",
    "Lack of comprehensive studies using and reporting controls for environmental comfort elements (IEQ) to determine effects of design characteristics.",
    "Need for more research to elucidate how design variables of the built environment affect human emotion."
  ],
  "risk_of_bias_assessment": "Assessed using the Cochrane Collaboration Risk of Bias Tool. No studies were excluded for risk bias. Specific biases identified include unclear intervention allocation (6/7 studies), unclear blinding of participants/personnel, incomplete outcome data (2 studies), unclear selective reporting (2 studies), and a key contamination concern regarding unreported comfort qualities (IEQ) in most studies.",
  "heterogeneity_sources": [
    "Vast differences in methodologies applied.",
    "Range of different experimental approaches.",
    "Lack of consistency in data analysis procedures.",
    "Range of data representation methods.",
    "Inconsistent reporting of participant characteristics.",
    "Lack of rationale for calculating sample size.",
    "Presentation of p-values without effect sizes or correlation coefficients.",
    "Use of different techniques, protocols, and programs for objective data decoding."
  ],
  "publication_bias": null,
