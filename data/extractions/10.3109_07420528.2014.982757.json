  "title": "Lack of exposure to natural light in the workspace is associated with physiological, sleep and depressive symptoms",
  "authors": "Francine Harb et al., 2015",
  "research_question": "To evaluate the effects of exposure or lack of exposure to natural light in a rest/activity rhythm on cortisol and melatonin levels, as well as on psychological variables in humans under natural conditions.",
  "design_type": "cross_sectional",
  "participants": {
    "n": 20,
    "description": "20 female employees (mean age 41.3 \u00b1 11.5 years for 'with window' group, 44.60 \u00b1 22.0 years for 'without window' group) from Hospital de Cl\u00ednicas de Porto Alegre, southern Brazil. All worked diurnal shifts (8:00 am - 6:00 pm) for at least one year. Excluded males, workers with history of stroke, psychiatric comorbidities, uncontrolled systemic diseases, movement disorders, emergency surgery, illicit drug use, or specific medication use.",
    "recruitment": "Employees of Hospital de Cl\u00ednicas de Porto Alegre"
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Two types of workspaces: 'with window' group (10 employees) worked in environments with natural light through a window in addition to electrical lighting; 'without window' group (10 employees) worked in environments with only electrical lighting with no visual contact to the outdoors or outdoor light.",
      "n_stimuli": 2,
      "source": "p.3"
    }
  ],
