  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "Projected lantern-slides of wallpaper patterns (two types: regular rectangular elements and irregular unfamiliar elements) onto a translucent screen. These images had varying gradients of texture density, corresponding to physical slants of 10\u00b0, 22\u00b0, 30\u00b0, and 45\u00b0 from the perpendicular. Each slide was used twice (inverted) to produce upward and downward density gradients. Observers viewed monocularly through two hole-screens to eliminate contours and other depth cues.",
      "n_stimuli": 16,
      "source": "Image on the screen section, p. 377"
    }
  ],
  "measures": [
