  "title": "An immersive multisensory virtual reality approach to the study of human-built environment interactions",
  "authors": "Kun Lyu et al., 2023",
  "research_question": "To develop a novel method for studying human-built environment interaction under multimodal (visual, auditory and thermal) conditions using virtual reality technology, and to apply this method to understand end-users' response to a semi-outdoor environment involving visual, thermal, and auditory stimuli.",
  "design_type": "pre_post",
  "participants": {
    "n": 38,
    "description": "Participants for a within-subject experiment with two MIVE scenarios. Specific demographics not provided in this paper, referred to Lyu et al. (2022).",
    "recruitment": null
  },
  "stimuli_or_exposures": [
    {
      "type": "VR",
      "description": "Multisensory Immersive Virtual Environment (MIVE) simulating a semi-outdoor environment (SkyPark, Melbourne CBD, Australia). Visuals included detailed 3D models of buildings, greenery, animated objects, realistic material shaders, and atmospheric conditions (sunlight, daylight, wind cues like falling leaves, grass/tree movement). Auditory stimuli included ambient traffic noise, bird songs (Magpie, Golden Whistler), pedestrian crossing signals, tram bells, and breeze rustling tree leaves, rendered binaurally using HRTFs. Thermal stimuli included ambient air temperature (28°C, 60% RH) delivered by constant air volume AC, direct solar radiation simulated by 10 quartz tungsten halogen lamps (250W each) achieving mean radiant temperatures (Tmrt) between 35.0-39.6°C, and wind simulated by bladeless fans achieving 0.95 m/s. Two scenarios were presented: 'sunlight only' and 'sunlight + shade' (offering adaptive opportunity to move between sun and shade).",
      "n_stimuli": 2,
      "source": "Section 4, Fig. 3, Fig. 4, Fig. 6, Table 1, Table 2"
    }
  ],
