  "title": "Visual Space Perception and Visually Directed Action",
  "authors": "Jack M. Loomis et al., 1992",
  "research_question": "This work investigates whether natural environments viewed binocularly from a stationary vantage point are perceived correctly, and how the properties of visually perceived space relate to visually directed action, particularly open-loop motoric tasks. The central aim is to reconcile seemingly contradictory results from psychophysical matching tasks (showing distortions) and visually directed action tasks (showing accuracy).",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 10,
    "description": "Experiment 1 & 2: 10 men (20-33 years old for Exp 1, 18-33 years old for Exp 2), students at the University of São Paulo, Brazil, with at least 20/20 visual acuity (corrected or uncorrected), active nonprofessional players of soccer, volleyball, or basketball. Experiment 3: 5 graduate students (24-29 years old) at the University of California, Santa Barbara, with 20/20 visual acuity.",
    "recruitment": "Voluntary, unpaid observers."
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "Experiments 1 & 2: A large grassy field (35m x 20m) with a grid of white lines (1m squares) and a central axis. Targets were white steel rods (16cm high, 1cm diameter) sharpened at one end. Experiment 1 used frontal intervals (1.0, 1.5, 2.0m) at 4, 6, 8, 10, or 12m from the origin, and subjects adjusted depth intervals. Experiment 2 used a first target directly in front (4, 6, 8, 10, or 12m) and a second target (1.0, 1.5, 2.0m away) either in depth or width. Experiment 3: A lightproof warehouse (35m x 20m) with a square workspace (1200cm side). A single red neon lamp target placed on the ground at the center. Parallel straight paths (6m long) marked on the ground, with nearest approach distances of 100, 200, or 400 cm to the target.",
      "n_stimuli": null,
      "source": "Methods sections, Figures 2, 4, 8"
    }
  ],
  "measures": [
    {
      "construct": "Perceived exocentric interval length (depth vs. frontal)",
      "instrument": "Psychophysical matching task (subjective adjustment of depth interval to match frontal interval)",
      "type": "behavioral"
    },
    {
      "construct": "Locomotor distance estimation accuracy",
      "instrument": "Blind walking to previously viewed target(s)",
      "type": "behavioral"
    },
    {
      "construct": "Spatial localization (direction of unseen target)",
      "instrument": "Continuous blind pointing with the right arm while walking",
      "type": "behavioral"
    }
  ],
