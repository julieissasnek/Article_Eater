  "theory_commitments": [
    {
      "theory_name": "Attention Restoration Theory (ART)",
      "commitment_type": "applies",
      "specific_claim": "Natural environments, including indoor plants, can restore directed attention and reduce mental fatigue by engaging involuntary attention (soft fascination)."
    },
    {
      "theory_name": "Stress Reduction Theory (SRT)",
      "commitment_type": "applies",
      "specific_claim": "Exposure to natural environments elicits positive emotional states and physiological responses (e.g., reduced blood pressure, heart rate) that facilitate recovery from stress."
    },
    {
