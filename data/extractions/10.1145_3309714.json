  "components": [
    {
      "name": "Three Coordinates of HBI Research",
      "description": "People, Built Environment, and Computing, reflecting the three relevant entities for HBI questions.",
      "validation": null
    },
    {
      "name": "Three Interrelated Dimensions of HBI Research",
      "description": "Physical (or physical-material), Social (or social-cultural), and Spatial (or spatial-configurational), specifying directions for HBI research.",
      "validation": null
    },
    {
      "name": "Four Fronts for HBI Methodological Development",
      "description": "1. Developing and re-appropriating frameworks, concepts, vocabularies, and discourses within architecture and urban design. 2. Examining how existing user research methods from HCI and other disciplines can be reappropriated. 3. Developing new and novel methods for emerging phenomena like AI and new forms of interactivity in built environments. 4. Reconciling differences in methods, terminology, and approaches between Architecture and HCI.",
      "validation": null
    }
  ],
  "psychometric_properties": {
    "reliability": null,
    "validity": null
  },
  "recommended_use": "To provide a framework to understand, compare, and relate converging research efforts from HCI and Architecture in envisioning and shaping the future of living; to inform design researchers about the effectiveness of design interventions; to contribute to the generalized framework of HBI (design heuristics, strong concepts, evaluation methods); to exemplify rigor in HBI methodological and conceptual contributions and opportunities for grounded experiment-based HBI studies; to ignite discussions for a foundation for future HBI research and design; to help situate HBI among HCI sub-domains and potentially lead to independent scientific events.",
