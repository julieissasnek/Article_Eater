  "title": "A Shared Representation of the Space Near Oneself and Others in the Human Premotor Cortex",
  "authors": "Claudio Brozzoli et al., 2013",
  "research_question": "Does the human brain construct a low-level, body-centered representation of the space around others similar to one's own peripersonal space representation, specifically in the human ventral premotor cortex?",
  "research_focus": "To identify neuronal populations in the human ventral premotor cortex that encode the space near both one's own hand and another person's hand, using fMRI BOLD adaptation.",
  "methodology": {
    "n_participants": {
      "experiment_1": 26,
      "experiment_2": 20
    },
    "participant_demographics": "Experiment 1: 26 participants (19-35 years old, mean ± SD age 28 ± 5 years; 18 males). Experiment 2: 20 participants (22-42 years old, mean ± SD age = 29 ± 6; 12 males; 5 also participated in experiment 1).",
    "study_design": "Two fMRI experiments using a BOLD adaptation paradigm. Experiment 1: 2x2 factorial design comparing adaptation to a moving object near another person's real hand vs. a prosthetic hand, following identical visual stimulation near the participant's own hand. Experiment 2: Bidirectional adaptation design (stimulation near own hand then other's hand, and vice versa), with control conditions for stimulation only near own/other's hand and a far position.",
    "measures": "Blood oxygen level-dependent (BOLD) signal, Adaptation Index (difference in contrast estimate).",
    "analysis_approach": "fMRI data analyzed with SPM8. First-level analyses defined regressors for 3s stimulation periods. Second-level random-effects group analysis. Significance threshold p < 0.05 FWE-corrected, small-volume corrections for PMv.",
    "environment_setting": "MRI scanner room with participant's head tilted forward, right hand placed on a table in direct view. Another person's hand or a prosthetic hand placed on a support 100 cm in front of the participant's hand. White curtains occluded other objects and experimenters from view.",
    "stimuli": "Moving spherical object (small red ball, 3 cm diameter, attached to a stick) moved repeatedly up and down, 2 cm above the fingers, for 3s."
  },
