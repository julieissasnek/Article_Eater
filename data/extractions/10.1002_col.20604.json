  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "Sets of 10 multicolored images (photos and graphics) selected from a database of 5000 images. Samples were chosen based on pilot study judgments to provide homogeneous coverage of the emotion space. Maximum sample size was 70 pixels.",
