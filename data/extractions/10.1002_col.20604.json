  "research_question": "Do people perceive color emotions for multi-colored images in similar ways, and do observer judgments correlate with a recently proposed predictive model for image retrieval?",
  "design_type": "within_subjects",
  "participants": {
    "n": 33,
    "description": "33 observers (after removing 2 invalid responses) from a group of colleagues, students, and friends, both males and females, ranging from ~20-65 years old, primarily from Sweden.",
