  "theory_commitments": [
    {
      "theory_name": "Circadian Photoreception Theory",
      "commitment_type": "discusses",
      "specific_claim": "Non-image-forming photoreceptors (e.g., melanopsin-containing retinal ganglion cells) mediate the effects of light on circadian rhythms, alertness, and mood, with particular sensitivity to short-wavelength (blue) light."
    },
    {
      "theory_name": "Trichromatic Theory of Color Vision",
      "commitment_type": "assumes",
      "specific_claim": "Human color and brightness perception are based on the differential activation of three types of cone photoreceptors, each maximally sensitive to different wavelengths of light (red, green, blue)."
    },
    {
      "theory_name": "Visual Comfort Theory",
      "commitment_type": "discusses",
      "specific_claim": "Visual comfort is influenced by various lighting parameters such as luminance levels, uniformity, glare, and color rendering, impacting user satisfaction and performance."
    }
  ],
