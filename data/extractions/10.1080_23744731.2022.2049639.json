  "title": "Physiological and psychological responses and cognitive performance with a window view",
  "authors": "Kuniaki Mihara et al., 2022",
  "research_question": "To investigate the effect of a window view on physiological responses, mood, and cognitive performance, to find the relationship among these factors, and to compare physiological responses and cognitive performance between real and virtual environments.",
  "design_type": "within_subjects",
  "participants": {
    "n": 26,
    "description": "26 healthy office workers (23 males, 3 females) in Singapore, aged 25 to 59 years (mean 42.5 \u00b1 9.0 years). Mean clothing value 0.55 \u00b1 0.11 clo.",
    "recruitment": "Voluntarily participated"
  },
  "stimuli_or_exposures": [
    {
      "type": "physical_space",
      "description": "A meeting room (34 m\u00b2) in an office on the eighth floor of the Kajima Technical Research Institute Singapore. Conditions: (1) closed blinds, (3) window view (buildings, greenery, sky, oceans). Room temperature 23\u00b0C, illuminance 513\u00b11 lx (closed blinds) and 1969\u00b1340 lx (window view).",
      "n_stimuli": 2,
      "source": "Figure 1, Methods section"
    },
    {
      "type": "VR",
      "description": "Virtual environment presented via Oculus Rift S VR headset (Fast-switch LCD 2560 * 1440 @80 Hz). Conditions: (2) closed blinds (virtual), (4) window view (virtual, created from 12-megapixel pictures from seated position).",
      "n_stimuli": 2,
      "source": "Methods section"
    }
  ],
  "measures": [
    {
      "construct": "Skin temperature",
      "instrument": "iButton (\u00b1 0.5\u00b0C uncertainty) at 4 points (left upper chest, left upper outside arm, right thigh, right lower leg)",
      "type": "physiological"
    },
    {
      "construct": "Skin conductance",
      "instrument": "Shimmer 3 (\u00b1 3% uncertainty) at second joint of middle and index fingers",
      "type": "physiological"
    },
    {
      "construct": "Heart-rate variability (RMSSD)",
      "instrument": "Polar H10 heart-rate sensor, Kubios HRV Standard 3.4.1",
      "type": "physiological"
    },
    {
      "construct": "Heart-rate variability (pNN50)",
      "instrument": "Polar H10 heart-rate sensor, Kubios HRV Standard 3.4.1",
      "type": "physiological"
    },
    {
      "construct": "Mean heart rate",
      "instrument": "Polar H10 heart-rate sensor",
      "type": "physiological"
    },
    {
      "construct": "Electroencephalography (EEG) relative band power",
      "instrument": "EMOTIV EPOC X (14 channels: AF3, F7, F3, FCS, T7, P7, O1, O2, P8, T8, FC6, F4, F8, AF4)",
      "type": "neural"
    },
    {
      "construct": "Environmental satisfaction",
      "instrument": "7-point Likert scale (thermal comfort, air quality, humidity, visual comfort, noise level)",
      "type": "self_report"
    },
    {
      "construct": "Mood",
      "instrument": "Circumplex model (Russell 1980; Watson and Tellegen 1985) on a 5-point scale (enthusiastic, surprised, relaxed, pleased, dull, quiet, nervous, sad)",
      "type": "self_report"
    },
    {
      "construct": "Self-reported performance",
      "instrument": "7-point scale for motivation, 5-point scale for arousal, concentration, productivity, stress",
      "type": "self_report"
    },
    {
      "construct": "Simulator Sickness Questionnaire (SSQ)",
      "instrument": "SSQ",
      "type": "self_report"
    },
    {
      "construct": "Selective attention (Stroop test)",
      "instrument": "Stroop test (interference score calculated from reaction time and uncorrected errors)",
      "type": "cognitive"
    },
    {
      "construct": "Short-term working memory",
      "instrument": "Visual backward digit span test (longest digit span)",
      "type": "cognitive"
    },
    {
      "construct": "Creativity",
      "instrument": "Guilford's Alternative Uses (AU) test (mean creativity scores of three raters)",
      "type": "cognitive"
    }
  ],
