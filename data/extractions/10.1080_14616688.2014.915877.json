  "title": "Effect of dimensions of place attachment on residents' word-of-mouth behavior",
  "authors": "Ning (Chris) Chen, Larry Dwyer & Tracey Firth, 2014",
  "research_question": "To examine and compare the effect of residents' different dimensions of place attachment on their word-of-mouth (WOM) behavior in two cities: Sydney, Australia and Shanghai, China.",
  "hypotheses": [
    "H1: The more satisfied residents are with the place, the more they identify with the place.",
    "H1: The more satisfied residents are with the place, the more they depend on the place.",
    "H1: The more satisfied residents are with the place, the more they are affectively connected to the place.",
    "H1: The more satisfied residents are with the place, the stronger social bonds they commit to the place.",
    "H1: There is a positive relationship between place satisfaction and place memory.",
    "H1: There is a positive relationship between place satisfaction and place expectation.",
    "H2: The more attached residents are to the place, the more they generate one-to-one WOM."
  ],
  "methodology": {
    "study_design": "Cross-sectional survey",
    "n_participants": 691,
    "participant_demographics": "361 Sydney residents (mean age 40.5, 50.1% male, mean residence 24.4 years); 330 Shanghai residents (mean age 32.6, 48.5% male, mean residence 20.2 years). All participants had lived in their respective city for at least one year.",
    "environment_setting": "Urban residential (Sydney, Australia and Shanghai, China)",
    "environmental_features": "Not specific physical environmental features, but residents' psychological relationship with their city (place attachment dimensions).",
    "measures": {
      "place_attachment": "Six-dimensional construct: Place Identity, Place Dependence, Affective Attachment, Social Bonding (attitudinal); Place Memory, Place Expectation (interactional). Measured with 15 adapted items from Yuksel et al. (2009), Nielsen-Pincus et al. (2010), Kyle et al. (2005). Interactional dimensions were developed for this research.",
      "word_of_mouth": "One-to-one WOM behavior, measured with a three-item, 7-point Likert scale adapted from Arnett, German, and Hunt (2003).",
      "place_satisfaction": "Overall place satisfaction, measured with a three-item, 7-point Likert scale (1 'Very dissatisfied' to 7 'Very satisfied')."
    },
    "data_analysis": "Confirmatory Factor Analysis (CFA) and Structural Equation Modeling (SEM) using IBM SPSS Amos 20. Maximum likelihood (ML) estimation."
  },
