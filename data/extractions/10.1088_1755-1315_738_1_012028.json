  "mechanisms": [
    "Insufficient lighting leads to drastically decreased cortisol levels, which can be interpreted as an increase in melatonin, subsequently leading to decreased alertness."
  ],
  "moderators": [
    "Fasting conditions (Ramadhan)",
    "Hawthorn effect (potential influence on self-report measures)"
  ],
  "implementation_implications": [
    "Insufficient lighting in the workplace may not be suitable for maintaining workers' mood and alertness based on physiological data, despite no subjective complaints."
  ],
