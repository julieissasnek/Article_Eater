  "moderators": [
    {
      "variable": "Gravitational cues",
      "effect": "The presence and strength of gravitational cues modulate the magnitude and presence of the haptic oblique effect, with stronger cues generally leading to a more pronounced effect.",
      "significant": true,
      "subgroup_effects": "Oblique effect is absent in supported forearm conditions or with reduced gravity, but present with normal gravity or unsupported forearm."
    },
    {
      "variable": "Plane of exploration/reproduction",
      "effect": "The spatial plane in which orientations are explored and reproduced influences the haptic oblique effect, with the effect being present in frontal and sagittal planes but sometimes absent in the horizontal plane under ipsilateral reproduction.",
      "significant": true,
      "subgroup_effects": "Oblique effect present in frontal/sagittal planes; absent in horizontal plane with ipsilateral reproduction but present with contralateral reproduction."
    },
    {
      "variable": "Reproduction hand (ipsilateral vs. contralateral)",
      "effect": "The use of the contralateral hand for reproduction tends to induce or strengthen the oblique effect compared to ipsilateral reproduction, suggesting a more complex sensorimotor transformation.",
      "significant": true,
      "subgroup_effects": "Oblique effect present in contralateral conditions, sometimes absent in ipsilateral conditions (e.g., horizontal plane, uninformed)."
    },
    {
      "variable": "Prior visual experience (informed vs. uninformed)",
      "effect": "Prior knowledge or visual experience of standard orientations can influence the magnitude of the haptic oblique effect, with informed participants showing a stronger effect.",
      "significant": true,
      "subgroup_effects": "Oblique effect maximal in informed contralateral condition, diminished in uninformed contralateral."
    },
    {
      "variable": "Memory constraints/Cognitive load (interfering tasks, delay duration)",
      "effect": "Increased cognitive load or memory demands (e.g., during a delay period with interfering tasks) can induce or strengthen the haptic oblique effect, even in conditions where it would otherwise be absent.",
      "significant": true,
      "subgroup_effects": "Oblique effect absent with reduced gravity and unoccupied delay, but present with interfering verbal or motor tasks regardless of gravity."
    },
    {
      "variable": "Body tilt",
      "effect": "Tilting the body affects the perception of vertical and horizontal orientations, leading to the disappearance of the haptic oblique effect in tilted conditions, as the subjective vertical becomes the most accurately perceived orientation.",
      "significant": true,
      "subgroup_effects": "Oblique effect present in upright body condition, absent in tilted body conditions."
    },
    {
      "variable": "Haptic contextual cues",
      "effect": "The presence of congruent haptic contextual cues can enhance the precision of orientation perception and weaken the haptic oblique effect.",
      "significant": true,
      "subgroup_effects": "Precision of adjustments significantly improved with congruent contextual cues, weakening the oblique effect."
    },
    {
      "variable": "Age (infants, children, adults)",
      "effect": "The haptic oblique effect is observed across different age groups, from infancy to adulthood, with its presence in infants being linked to the development of the shoulder-arm-hand system and gravitational cues.",
      "significant": true,
      "subgroup_effects": "Oblique effect present from 5 months of age, influenced by gravitational cues."
    }
