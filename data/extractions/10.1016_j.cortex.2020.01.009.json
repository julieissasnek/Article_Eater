  "title": "Psychological and neural responses to architectural interiors",
  "authors": "Alexander Coburn et al., 2020",
  "research_question": "1) Can aesthetic responses to architectural scenes be reduced to a few key psychological dimensions? 2) Are these dimensions sensitive to salient design features and Global Image Properties (GIPs)? 3) Do these psychological dimensions correlate with neural activation patterns, and to what extent are these correlations modulated by task?",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 1420,
    "description": "Experiment 1: 798 US-based adults (391 women, 401 men, 6 other; M=38.06 years, SD=11.96). Experiment 2: 614 American adults (305 women, 307 men, 2 other; M=35.68 years, SD=10.87). Experiment 3: 18 healthy participants (12 females, 6 males; M=23.39 years, SD=4.49) from the Canary Islands.",
    "recruitment": "Amazon's Mechanical Turk for Experiments 1 and 2. Not specified for Experiment 3 (reanalysis of previous fMRI studies)."
  },
  "stimuli_or_exposures": [
    {
      "type": "photograph",
      "description": "200 images of interior architectural spaces, counterbalanced on perceived enclosure (open/closed), ceiling height (high/low), and contour (round/square). This yielded 8 experimental conditions (25 images per condition).",
      "n_stimuli": 200,
      "source": "Section 2.1.1, Figure 2"
    }
  ],
  "measures": [
    {
      "construct": "Aesthetic response measures",
      "instrument": "16 aesthetic rating scales (Complexity, Organization, Naturalness, Beauty, Personalness, Interest, Modernity, Valence, Stimulation, Vitality, Comfort, Relaxation, Hominess, Uplift, Approachability, Explorability) on a 7-point sliding semantic differential scale.",
      "type": "self_report"
    },
    {
      "construct": "Psychological dimensions of architectural experience",
      "instrument": "Principal Component Analysis (PCA) scores for Coherence, Hominess, and Fascination.",
      "type": "cognitive"
    },
    {
      "construct": "Global Image Properties (GIPs)",
      "instrument": "Self-similarity (Pyramidal Histogram of Oriented Gradients - PHOG method) and Complexity (HOG Complexity method).",
      "type": "computational"
    },
    {
      "construct": "Neural activity",
      "instrument": "fMRI BOLD signal",
      "type": "neural"
    },
    {
      "construct": "Beauty judgment",
      "instrument": "Button press: 'beautiful' or 'not beautiful'",
      "type": "behavioral"
    },
    {
      "construct": "Approach-avoidance decision",
      "instrument": "Button press: 'enter' or 'exit' the space",
      "type": "behavioral"
    }
  ],
