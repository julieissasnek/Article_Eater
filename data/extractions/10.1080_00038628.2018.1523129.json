  "title": "Examining wayfinding behaviours in architectural spaces using brain imaging with electroencephalography (EEG)",
  "authors": "\u0130lker Erkan, 2018",
  "research_question": "To assess the effect of gender, age, level of education, and ceiling height on cognitive processing and wayfinding, and to investigate these effects on architectural design using a brain imaging method. Specifically, the study investigates: H.1: What effect does spatial design have on wayfinding behaviour? H.2: What is the effect of objects located in the designed space on the wayfinding behaviour of people? H.3: What is the effect of space height on wayfinding behaviour? H.4: Do factors such as education level and gender affect wayfinding behaviour?",
  "design_type": "mixed_factorial",
  "participants": {
    "n": 340,
    "description": "343 healthy volunteers (3 female participants left during the experiment, so their data were removed, resulting in N=340). Age ranged from 18 to 65 years (average age men: 36.94, women: 34.76). Participants were instructed not to take any medication or use tobacco/alcohol the day before the experiment. Participants had no psychiatric condition or severe eye problems.",
    "recruitment": "Healthy volunteers"
  },
  "stimuli_or_exposures": [
    {
      "type": "VR",
      "description": "Three virtual reality mazes (labyrinths) of identical plan layout (90 m\u00b2), materials, and colors, but varying in ceiling height: Space-I (3.5 m), Space-II (3 m), Space-III (2.5 m). Participants navigated using Samsung Gear VR-w/Controller.",
      "n_stimuli": 3,
      "source": "p. 4, Figure 2, Figure 3"
    },
    {
      "type": "plan_drawing",
      "description": "2D plan layouts of the three mazes, showing start and end points, for initial memorization by participants.",
      "n_stimuli": 3,
      "source": "p. 5, Figure 2"
    },
    {
      "type": "rendering",
      "description": "30 different virtual objects (e.g., watches, mirrors, books, racks, vases, carpets, lighting elements, pictures) placed within the three mazes, used for object-space matching test.",
      "n_stimuli": 30,
      "source": "p. 6, Appendix 1"
    }
  ],
  "measures": [
    {
      "construct": "Wayfinding performance (exit time)",
      "instrument": "Time taken to exit each virtual maze (up to 240s limit)",
