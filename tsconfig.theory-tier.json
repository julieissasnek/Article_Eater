{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/template.ts",
    "src/types/reduction.ts",
    "src/types/attribute.ts",
    "src/types/crossReference.ts",
    "src/types/claim.ts",
    "src/types/extraction.ts",
    "src/theory/api.ts",
    "src/theory/templateRegistry.ts"
  ]
}
