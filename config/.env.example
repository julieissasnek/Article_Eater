# Example configuration for Article Eater

# Environment: dev, staging, prod
AE_ENV=dev

# LLM provider identifier (e.g., fake, openai, vertex, bedrock)
AE_LLM_PROVIDER=fake

# Graph backend: jsonl (fallback) or neo4j
AE_GRAPH_BACKEND=jsonl

# Secret key for session cookies (change in production!)
AE_SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# Whether to set session cookies as `Secure` (strongly recommended in prod)
AE_SESSION_COOKIE_SECURE=false

# Log level: DEBUG, INFO, WARNING, ERROR
AE_LOG_LEVEL=INFO
