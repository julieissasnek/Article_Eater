{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Molecule Taxonomy",
    "description": "Molecules are latent variables that explain correlated patterns of T2 template co-activation. They package multiple mechanism chains into coherent effect bundles. Some are theoretically proposed (hand-defined from domain knowledge); others could be computationally discovered from template co-occurrence across findings.",
    "version": "1.0.0",
    "ontological_status": {
        "what_they_are": "Latent variables — not directly observed, but inferred from patterns of template co-activation across empirical findings.",
        "how_they_relate_to_T1_5": "All T1.5 domain theories (ART, SRT, Biophilia, Prospect-Refuge) are molecules with established literature authorship. Other molecules are system-defined or computationally discovered composites without a canonical published theory backing them.",
        "discoverability": "New molecules can be discovered by analysing template co-occurrence patterns across the corpus. If templates X, Y, Z consistently co-activate across many findings, the underlying latent factor is a candidate molecule. Existing molecules are hypothesised latent structures awaiting empirical confirmation or refinement.",
        "interaction_types": [
            "ADDITIVE (effects sum)",
            "SYNERGISTIC (combined effect > sum of parts)",
            "PREREQUISITE (one must precede another)",
            "ANTAGONISTIC (effects partially cancel)"
        ],
        "maturity_levels": [
            "HYPOTHESISED (proposed, not yet tested)",
            "TENTATIVE (some support)",
            "SUPPORTED (strong evidence)",
            "ESTABLISHED (canonical)"
        ]
    },
