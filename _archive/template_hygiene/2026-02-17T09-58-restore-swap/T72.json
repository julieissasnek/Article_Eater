{
    "template_id": "CCT_TEMPORAL_ECOLOGICAL_001",
    "name": "Ecological Color Temperature Association",
    "structural_pattern": "ASSOCIATION",
    "higher_order_principle": "Human vision has an evolved prior that associates Color Temperature (CCT) with Time of Day and Solar Angle. High CCT (Blue-White) = Midday/Sky. Low CCT (Yellow-Red) = Evening/Fire/Dawn. Violating this association (e.g., dim cool light or bright warm light) creates a 'Kruithof effect' discomfort — a form of ecological prediction error.",
    "transferable_to": [
        "hospitality lighting (dim to warm)",
        "office lighting (work vs relax modes)",
        "urban street lighting"
    ],
    "framework_ids": [
        "PP",
        "EC"
    ],
    "causal_links": [
        {
            "from_variable": "CCT_intensity_combination",
            "to_variable": "affective_evaluation",
            "activity": "Kruithof_curve_compliance",
            "from_level": "subpersonal",
            "to_level": "personal_epistemic",
            "bridging_quality": "MEDIUM",
            "maturity": "how-plausibly",
            "key_evidence": "Kruithof, 1941; Fotios, 2017 (Critique)",
            "parameters": {
                "Congruent": "High Lux + High CCT (Day) OR Low Lux + Low CCT (Evening)",
                "Incongruent": "Low Lux + High CCT (e.g., cloudy day gloom, morgue) -> Negative Affect",
                "Mechanism": "Implicit prediction error of natural light statistics."
            }
        }
    ],
    "scope_conditions": [
        "The Kruithof curve is debated empirically but holds strongly as an ecological prior.",
        "Cultural variation: Some cultures prefer high CCT even at low levels (e.g., tropical climates associations with coolness)."
    ],
    "moderators": [
        "culture",
        "thermal_environment (cool light feels better in hot room)",
        "surface_colors (room finish affects reflected CCT)"
    ],
    "interactions": [
        {
            "template": "T70 (CIRCADIAN_ARCH_REGULATION_001)",
            "type": "ALIGNMENT",
            "description": "T72 reinforces T70. The ecological cue (Color) matches the physiological driver (Spectrum)."
