{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ae.query_request.v1.schema.json",
  "schema_id": "ae.query_request.v1",
  "title": "AE Query Request (v1)",
  "description": "Schema for submitting queries to the Article Eater Query Engine. MVP-0 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "query_id",
    "query_text"
  ],
  "properties": {
    "schema": {
      "const": "ae.query_request.v1"
    },
    "query_id": {
      "type": "string",
      "description": "Unique identifier for this query request",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "description": "Natural language query text",
      "minLength": 1,
      "maxLength": 2000
    },
    "response_mode": {
      "type": "string",
      "description": "Progressive disclosure level (per Simon)",
      "enum": ["headline", "summary", "detail", "deep_dive"],
      "default": "summary"
    },
    "query_type_hint": {
      "type": ["string", "null"],
      "description": "Optional hint for query type to help parsing",
      "enum": [
        "what_is",
        "does_affect",
        "how_much",
        "what_know",
        "what_evidence",
        "compare",
        "which_better",
        "confidence",
        "why_believe",
        "contradicts",
        "what_unknown",
        "when_does",
        "for_whom",
        null
      ]
    },
    "causal_level_hint": {
      "type": ["string", "null"],
      "description": "Optional hint for causal level (per Pearl's ladder)",
      "enum": [
        "associational",
        "interventional",
        "counterfactual",
        "descriptive",
        null
      ]
    },
    "subject_terms": {
      "type": "array",
      "description": "Optional subject terms to focus search (e.g., ['natural light', 'biophilia'])",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outcome_terms": {
      "type": "array",
      "description": "Optional outcome terms to focus search (e.g., ['stress', 'productivity'])",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "include_gaps": {
      "type": "boolean",
      "description": "Whether to include gap analysis in response",
      "default": false
    },
    "max_results": {
      "type": "integer",
      "description": "Maximum number of belief results to return",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "min_credence": {
      "type": "number",
      "description": "Minimum belief credence threshold",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.3
    },
    "context": {
      "type": ["object", "null"],
      "description": "Optional context for the query",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": ["string", "null"],
          "description": "Target population (e.g., 'office workers', 'hospital patients')"
        },
        "setting": {
          "type": ["string", "null"],
          "description": "Target setting (e.g., 'indoor', 'healthcare', 'education')"
        },
        "theory_filter": {
          "type": "array",
          "description": "Limit results to specific theories",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "Optional metadata about the request",
      "additionalProperties": true,
      "properties": {
        "session_id": {
          "type": ["string", "null"]
        },
        "user_id": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
